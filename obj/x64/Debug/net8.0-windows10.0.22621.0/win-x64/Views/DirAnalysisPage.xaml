<Page x:ConnectionId='1'
    x:Class="AIM.Views.DirAnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:AIM.Converters"
    xmlns:models="using:AIM.Models"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12">
            <TextBlock Text="Directory Analysis" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Select a directory to view file count/size statistics and scan for file anomalies." TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:ConnectionId='27'                                                          IsReadOnly="True" PlaceholderText="Select a directory to analyze..." MinWidth="300"/>
                <Button x:ConnectionId='28' Content="Browse..."                                                            />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Target # of Devices (Ohio):" VerticalAlignment="Center"/>
                    <TextBox x:ConnectionId='26'                                                                                               Width="100"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Target # of Devices (I&amp;M):" VerticalAlignment="Center"/>
                    <TextBox x:ConnectionId='25'                                                                                             Width="100"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,20,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="10" Margin="0,0,12,0">
                        <TextBlock Text="Ohio" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="File Count:" Margin="0,0,10,0"/>
                            <TextBlock x:ConnectionId='21' Grid.Row="0" Grid.Column="1"                                                     />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Devices (Lines):" Margin="0,0,10,0"/>
                            <TextBlock x:ConnectionId='22' Grid.Row="1" Grid.Column="1"                                                       />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Difference:" Margin="0,0,10,0"/>
                            <TextBlock x:ConnectionId='23' Grid.Row="2" Grid.Column="1"                                                      />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Percentage:" Margin="0,0,10,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock>
                                    <Run x:ConnectionId='24'                                                                                                      />
                                </TextBlock>
                                <TextBlock Text="%"/>
                            </StackPanel>
                        </Grid>

                        <lvc:PieChart x:ConnectionId='20'
                                                                                    
                            Width="200" 
                            Height="200"
                            LegendPosition="Hidden"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10" Margin="12,0,0,0">
                        <TextBlock Text="I&amp;M" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="File Count:" Margin="0,0,10,0"/>
                            <TextBlock x:ConnectionId='16' Grid.Row="0" Grid.Column="1"                                                   />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Devices (Lines):" Margin="0,0,10,0"/>
                            <TextBlock x:ConnectionId='17' Grid.Row="1" Grid.Column="1"                                                     />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Difference:" Margin="0,0,10,0"/>
                            <TextBlock x:ConnectionId='18' Grid.Row="2" Grid.Column="1"                                                    />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Percentage:" Margin="0,0,10,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock>
                                    <Run x:ConnectionId='19'                                                                                                    />
                                </TextBlock>
                                <TextBlock Text="%"/>
                            </StackPanel>
                        </Grid>

                        <lvc:PieChart x:ConnectionId='15'
                                                                                  
                            Width="200" 
                            Height="200"
                            LegendPosition="Hidden"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,20,0,0" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel x:ConnectionId='2' Grid.Column="0" Spacing="10"                                                                                                                   >
                        <TextBlock Text="Directory Stats" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <ListView x:ConnectionId='9'                                                        >
                            <ListView.ItemTemplate>
                                <DataTemplate                                 >
                                    <Grid x:ConnectionId='11' ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:ConnectionId='12' Grid.Column="0"                          FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right"><Run x:ConnectionId='14'                                       /> files</TextBlock>
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Right"><Run x:ConnectionId='13'                                         /> devices</TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock x:ConnectionId='3' Text="File Anomalies" Style="{StaticResource SubtitleTextBlockStyle}"                                                                                                                                />
                        <ListView x:ConnectionId='4'                                                                MaxHeight="150"                                                                                                                          />

                        <TextBlock x:ConnectionId='5' Text="Misplaced 'IM' Files" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,10,0,0"                                                                                                                          />
                        <ListView x:ConnectionId='6'                                                                MaxHeight="150"                                                                                                                          />

                        <TextBlock x:ConnectionId='7' Text="Unidentified Files" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,10,0,0"                                                                                                                           />
                        <ListView x:ConnectionId='8'                                                                 MaxHeight="150"                                                                                                                           />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

