<Page
    x:Class="AIM.Views.InventoryViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:AIM.ViewModels"
    xmlns:converters="using:AIM.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:InventoryViewerViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- These converters are in your App.xaml, but for clarity and robustness,
             we can define them here or ensure they are in App.xaml.
             Based on your repo, they are in App.xaml, so this section is not strictly necessary
             but doesn't hurt. For this final version, I will rely on App.xaml. -->
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- THE FIX: Use your existing InverseBoolConverter for the IsEnabled property. -->
        <Button Grid.Row="0" Command="{Binding GoBackCommand}" Margin="0,0,0,12" IsEnabled="{Binding IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                <TextBlock Text="Back to Archive List"/>
            </StackPanel>
        </Button>

        <TextBlock Grid.Row="1" Text="{Binding ArchivePath, Mode=OneWay, FallbackValue='Inventory Viewer'}" Style="{ThemeResource TitleTextBlockStyle}"/>

        <!-- THE FIX: Use your existing InverseBoolConverter for the IsEnabled property. -->
        <AutoSuggestBox x:ConnectionId='2' Grid.Row="2"
                        x:Name="FilterBox"
                        PlaceholderText="Filter files and folders..."
                        QueryIcon="Find"
                        Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Margin="0,12,0,0"
                        IsEnabled="{Binding IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"/>

        <ProgressRing Grid.Row="3" 
                      IsActive="{Binding IsLoading, Mode=OneWay}" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center" 
                      Width="50" 
                      Height="50"/>

        <!-- THE FIX: Use your existing InverseBoolToVisibilityConverter to hide the TreeView while loading. -->
        <TreeView Grid.Row="3"
                  ItemsSource="{Binding RootNodes, Mode=OneWay}"
                  Margin="0,12,0,0"
                  Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <TreeView.ItemTemplate>
                <DataTemplate                                     >
                    <TreeViewItem ItemsSource="{Binding Children}" 
                                  Content="{Binding Content}" 
                                  Visibility="{Binding Visibility, Mode=OneWay}"
                                  IsExpanded="{Binding IsExpanded, Mode=TwoWay}"/>
                </DataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</Page>

