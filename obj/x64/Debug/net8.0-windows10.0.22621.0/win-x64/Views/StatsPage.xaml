<Page
    x:Class="AIM.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AIM.Models"
    xmlns:viewmodels="using:AIM.ViewModels"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:StatsViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
            <TextBlock Text="Statistics" Style="{ThemeResource TitleTextBlockStyle}"/>
            <Button Command="{Binding LoadStatsCommand}" Margin="24,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- THE FIX: Added HorizontalAlignment="Center" to this StackPanel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24" HorizontalAlignment="Center">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" MinWidth="200" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Total Files" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalFileCount, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" MinWidth="200" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Total Devices" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding TotalDeviceCount, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" MinWidth="200" Padding="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Problematic Files" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding ProblematicFileCount, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" Foreground="{ThemeResource SystemErrorTextColor}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="16">
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                    <StackPanel>
                        <TextBlock Text="Files by OpCo" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <lvc:PieChart x:ConnectionId='6'
                            x:Name="FileChart"
                            Height="180"
                            Width="325"
                            Series="{Binding OpCoFileSeries, Mode=OneWay}"
                            LegendPosition="Bottom"
                            LegendTextSize="12"
                            Background="Transparent"/>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="4">
                    <StackPanel>
                        <TextBlock Text="Devices by OpCo" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <lvc:PieChart x:ConnectionId='5'
                            x:Name="DeviceChart"
                            Height="180"
                            Width="325"
                            Series="{Binding OpCoDeviceSeries, Mode=OneWay}"
                            LegendPosition="Bottom"
                            LegendTextSize="12"
                            Background="Transparent"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Files with Lines !=17 Characters (Double-click to Preview)" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <ListView x:ConnectionId='2' x:Name="ProblematicFilesListView" Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding ProblematicFiles, Mode=OneWay}" IsItemClickEnabled="True"                                                     >
                    <ListView.ItemTemplate>
                        <DataTemplate                                    >
                            <TextBlock x:ConnectionId='4'                                                             Padding="0,8"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>

