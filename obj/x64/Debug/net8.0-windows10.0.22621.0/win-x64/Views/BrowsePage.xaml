<Page
    x:Class="AIM.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:viewmodels="using:AIM.ViewModels"
    xmlns:models="using:AIM.Models"
    xmlns:converters="using:AIM.Converters"
    d:DataContext="{d:DesignInstance Type=viewmodels:BrowseViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ItemsRepeater Grid.Column="0" ItemsSource="{Binding LeftBreadcrumbs}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate                                   >
                            <StackPanel x:ConnectionId='15' Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:ConnectionId='16'                                                           Style="{ThemeResource TextBlockButtonStyle}"                                                                                                                  >
                                    <TextBlock x:ConnectionId='19'                      FontWeight="SemiBold"/>
                                </Button>
                                <TextBlock x:ConnectionId='17'                      FontWeight="SemiBold"                                           VerticalAlignment="Center" Padding="8,4"/>
                                <TextBlock x:ConnectionId='18' Text="/" VerticalAlignment="Center" FontWeight="SemiBold"                                                                                                                  />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Button Grid.Column="1" Command="{Binding GoUpLeftCommand}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74A;" FontSize="16"/>
                        <TextBlock Text="Up"/>
                    </StackPanel>
                </Button>
            </Grid>

            <controls:DataGrid x:ConnectionId='11'
                x:Name="LeftDataGrid"
                Grid.Row="1"
                ItemsSource="{Binding LeftFilteredContents}"
                SelectionMode="Extended"
                AutoGenerateColumns="False"
                CanUserSortColumns="True"
                                              
                                                                
                                                        
                                                            
                CanDrag="True"
                                                        
                BorderBrush="Gray"
                BorderThickness="1"
                IsReadOnly="True">

                <controls:DataGrid.Columns>
                    <!-- THE FIX: Replaced SortMemberPath with Tag -->
                    <controls:DataGridTemplateColumn Header="Name" Tag="Name" Width="*">
                        <controls:DataGridTemplateColumn.CellTemplate>
                            <DataTemplate                                >
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,0,0,0">
                                    <SymbolIcon Symbol="{Binding SymbolIcon}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </controls:DataGridTemplateColumn.CellTemplate>
                    </controls:DataGridTemplateColumn>
                    <!-- THE FIX: Replaced SortMemberPath with Tag -->
                    <controls:DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDateString}" Tag="Date" Width="120"/>
                    <!-- THE FIX: Replaced SortMemberPath with Tag -->
                    <controls:DataGridTextColumn Header="Size" Binding="{Binding SizeString}" Tag="Size" Width="100"/>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Grid>

        <!-- Middle Column -->
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Spacing="8" Margin="16">
            <Button Command="{Binding RenameFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8AC;"/>
                    <TextBlock Text="Rename"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ArchiveFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7B8;"/>
                    <TextBlock Text="Archive"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ShipFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E1;"/>
                    <TextBlock Text="Shipped"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding MoveFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8DE;"/>
                    <TextBlock Text="Move →"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding UndoCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7A7;"/>
                    <TextBlock Text="Undo"/>
                </StackPanel>
            </Button>
            <Rectangle Height="24"/>
            <Button Command="{Binding CopyFromScansCommand}" Style="{ThemeResource AccentButtonStyle}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C8;"/>
                    <TextBlock Text="Copy from Scans"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Right Side -->
        <Grid Grid.Column="2" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ItemsRepeater Grid.Column="0" ItemsSource="{Binding RightBreadcrumbs}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate                                   >
                            <StackPanel x:ConnectionId='6' Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button x:ConnectionId='7'                                                            Style="{ThemeResource TextBlockButtonStyle}"                                                                                                                  >
                                    <TextBlock x:ConnectionId='10'                      FontWeight="SemiBold"/>
                                </Button>
                                <TextBlock x:ConnectionId='8'                      FontWeight="SemiBold"                                           VerticalAlignment="Center" Padding="8,4"/>
                                <TextBlock x:ConnectionId='9' Text="/" VerticalAlignment="Center" FontWeight="SemiBold"                                                                                                                  />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <Button Grid.Column="1" Command="{Binding GoUpRightCommand}" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74A;" FontSize="16"/>
                        <TextBlock Text="Up"/>
                    </StackPanel>
                </Button>
            </Grid>
            <ListView x:ConnectionId='2' Grid.Row="1" ItemsSource="{Binding RightFilteredContents}" SelectedItem="{Binding SelectedRightContent, Mode=TwoWay}" BorderBrush="Gray" BorderThickness="1" AllowDrop="True"                                                            >
                <ListView.ItemTemplate>
                    <DataTemplate                                >
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="{Binding SymbolIcon}"/>
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

