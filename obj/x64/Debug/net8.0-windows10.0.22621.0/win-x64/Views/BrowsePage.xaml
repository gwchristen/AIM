<Page x:ConnectionId='1'
    x:Class="AIM.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">
    <Grid Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                    <TextBox x:ConnectionId='18' Header="Root"                                                 IsReadOnly="True" Width="120"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox x:ConnectionId='23' Header="Level 1"                                                                                                               DisplayMemberPath="Name"                                                Width="120"/>
                        <Button x:ConnectionId='24' Content="&#xE711;" FontFamily="Segoe Fluent Icons"                               VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox x:ConnectionId='21' Header="Level 2"                                                                                                               DisplayMemberPath="Name"                                                Width="120"/>
                        <Button x:ConnectionId='22' Content="&#xE711;" FontFamily="Segoe Fluent Icons"                               VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox x:ConnectionId='19' Header="Level 3"                                                                                                               DisplayMemberPath="Name"                                                Width="120"/>
                        <Button x:ConnectionId='20' Content="&#xE711;" FontFamily="Segoe Fluent Icons"                               VerticalAlignment="Bottom"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <controls:DataGrid x:ConnectionId='17' Grid.Row="1"                                                                                                    AutoGenerateColumns="False" CanUserSortColumns="True"                                                                                             BorderBrush="Gray" BorderThickness="1" IsReadOnly="True">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Filename" Binding="{Binding Name}" Width="*"/>
                    <controls:DataGridTextColumn Header="Size" Binding="{Binding SizeString}" Width="100"/>
                    <controls:DataGridTextColumn Header="Date Created" Binding="{Binding CreatedDateString}" Width="120"/>
                    <controls:DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDateString}" Width="120"/>
                    <controls:DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="150"/>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Grid>

        <!-- Middle -->
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Spacing="8" Margin="16">
            <Button x:ConnectionId='11'                                                MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8AC;" FontSize="16"/>
                    <TextBlock Text="Rename"/>
                </StackPanel>
            </Button>
            <Button x:ConnectionId='12'                                                     MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7B8;" FontSize="16"/>
                    <TextBlock Text="Archive"/>
                </StackPanel>
            </Button>
            <Button x:ConnectionId='13'                                               MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E1;" FontSize="16"/>
                    <TextBlock Text="Shipped"/>
                </StackPanel>
            </Button>
            <Button x:ConnectionId='14'                                              MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8DE;" FontSize="16"/>
                    <TextBlock Text="Move →"/>
                </StackPanel>
            </Button>
            <Button x:ConnectionId='15'                                          MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16"/>
                    <TextBlock Text="Undo"/>
                </StackPanel>
            </Button>
            <Rectangle Height="24"/>
            <Button x:ConnectionId='16'                                                   Style="{ThemeResource AccentButtonStyle}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                    <TextBlock Text="Copy from Scans"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Right Side -->
        <Grid Grid.Column="2" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                    <TextBox x:ConnectionId='4' Header="Root"                                                 IsReadOnly="True" Width="120"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox x:ConnectionId='9' Header="Level 1"                                                                                                                 DisplayMemberPath="Name"                                                 Width="120"/>
                        <Button x:ConnectionId='10' Content="&#xE711;" FontFamily="Segoe Fluent Icons"                                VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox x:ConnectionId='7' Header="Level 2"                                                                                                                 DisplayMemberPath="Name"                                                 Width="120"/>
                        <Button x:ConnectionId='8' Content="&#xE711;" FontFamily="Segoe Fluent Icons"                                VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox x:ConnectionId='5' Header="Level 3"                                                                                                                 DisplayMemberPath="Name"                                                 Width="120"/>
                        <Button x:ConnectionId='6' Content="&#xE711;" FontFamily="Segoe Fluent Icons"                                VerticalAlignment="Bottom"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ListView x:ConnectionId='2' Grid.Row="1"                                                                                                                                                                                      BorderBrush="Gray" BorderThickness="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="{Binding IsFolder, Converter={StaticResource BoolToSymbolConverter}}"/>
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

