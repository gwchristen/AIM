<Page
    x:Class="AIM.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:viewmodels="using:AIM.ViewModels"
    xmlns:models="using:AIM.Models"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:system="using:System"
    d:DataContext="{d:DesignInstance Type=viewmodels:BrowseViewModel}"
    mc:Ignorable="d">

    <Grid Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                    <TextBox Header="Root" Text="{Binding RootName, Mode=OneWay}" IsReadOnly="True" Width="120"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox Header="Level 1" ItemsSource="{Binding LeftLevel1}" SelectedItem="{Binding SelectedLeftLevel1, Mode=TwoWay}" DisplayMemberPath="Name" Width="120"/>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Command="{Binding ClearLeftSelectionsCommand}" CommandParameter="1" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox Header="Level 2" ItemsSource="{Binding LeftLevel2}" SelectedItem="{Binding SelectedLeftLevel2, Mode=TwoWay}" DisplayMemberPath="Name" Width="120"/>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Command="{Binding ClearLeftSelectionsCommand}" CommandParameter="2" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox Header="Level 3" ItemsSource="{Binding LeftLevel3}" SelectedItem="{Binding SelectedLeftLevel3, Mode=TwoWay}" DisplayMemberPath="Name" Width="120"/>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Command="{Binding ClearLeftSelectionsCommand}" CommandParameter="3" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <controls:DataGrid Grid.Row="1" 
                               ItemsSource="{Binding Files}" 
                               SelectedItem="{Binding SelectedFile, Mode=TwoWay}" 
                               AutoGenerateColumns="False" 
                               CanUserSortColumns="True" 
                               BorderBrush="Gray" 
                               BorderThickness="1" 
                               IsReadOnly="True">
                <interactivity:Interaction.Behaviors>
                    <core:EventTriggerBehavior EventName="DoubleTapped">
                        <core:InvokeCommandAction Command="{Binding NavigateToPreviewCommand}" />
                    </core:EventTriggerBehavior>
                </interactivity:Interaction.Behaviors>
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Filename" Binding="{Binding Name}" Width="*"/>
                    <controls:DataGridTextColumn Header="Size" Binding="{Binding SizeString}" Width="100"/>
                    <controls:DataGridTextColumn Header="Date Created" Binding="{Binding CreatedDateString}" Width="120"/>
                    <controls:DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDateString}" Width="120"/>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Grid>

        <!-- Middle -->
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Spacing="8" Margin="16">
            <Button Command="{Binding RenameFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8AC;" FontSize="16"/>
                    <TextBlock Text="Rename"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ArchiveFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7B8;" FontSize="16"/>
                    <TextBlock Text="Archive"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ShipFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E1;" FontSize="16"/>
                    <TextBlock Text="Shipped"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding MoveFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8DE;" FontSize="16"/>
                    <TextBlock Text="Move →"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding UndoCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16"/>
                    <TextBlock Text="Undo"/>
                </StackPanel>
            </Button>
            <Rectangle Height="24"/>
            <Button Command="{Binding CopyFromScansCommand}" Style="{ThemeResource AccentButtonStyle}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                    <TextBlock Text="Copy from Scans"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Right Side -->
        <Grid Grid.Column="2" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                    <TextBox Header="Root" Text="{Binding RootName, Mode=OneWay}" IsReadOnly="True" Width="120"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox Header="Level 1" ItemsSource="{Binding RightLevel1}" SelectedItem="{Binding SelectedRightLevel1, Mode=TwoWay}" DisplayMemberPath="Name" Width="120"/>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Command="{Binding ClearRightSelectionsCommand}" CommandParameter="1" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox Header="Level 2" ItemsSource="{Binding RightLevel2}" SelectedItem="{Binding SelectedRightLevel2, Mode=TwoWay}" DisplayMemberPath="Name" Width="120"/>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Command="{Binding ClearRightSelectionsCommand}" CommandParameter="2" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox Header="Level 3" ItemsSource="{Binding RightLevel3}" SelectedItem="{Binding SelectedRightLevel3, Mode=TwoWay}" DisplayMemberPath="Name" Width="120"/>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Command="{Binding ClearRightSelectionsCommand}" CommandParameter="3" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ListView Grid.Row="1" ItemsSource="{Binding RightFilteredContents}" SelectedItem="{Binding SelectedRightContent, Mode=TwoWay}" BorderBrush="Gray" BorderThickness="1">
                <ListView.ItemTemplate>
                    <DataTemplate                                >
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="{Binding SymbolIcon}"/>
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

