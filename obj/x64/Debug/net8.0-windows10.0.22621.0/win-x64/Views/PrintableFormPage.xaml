<Page
    x:Class="AIM.Views.PrintableFormPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AIM.Models"
    xmlns:viewmodels="using:AIM.ViewModels"
    xmlns:converters="using:AIM.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:PrintableFormViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Your DataTemplates and TemplateSelector are required -->
        <DataTemplate x:Key="Level3HeaderTemplate"                            >
            <Grid BorderBrush="Black" BorderThickness="1,0,1,1" Background="#E2F0D9" MinHeight="35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Content}" FontWeight="SemiBold" Foreground="Black" Margin="8,4,8,4" VerticalAlignment="Center"/>
                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1,0,1,0"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FileTemplate"                            >
            <Grid BorderBrush="Black" BorderThickness="1,0,1,1" MinHeight="35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <TextBlock Grid.Column="1" Text="{Binding Content}" Foreground="Black" Margin="24,4,8,4" VerticalAlignment="Center" IsTextSelectionEnabled="True"/>
                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1,0,1,0"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="BlankTemplate"                            >
            <Grid BorderBrush="Black" BorderThickness="1,0,1,1" MinHeight="35">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="1,0,1,0"/>
            </Grid>
        </DataTemplate>
        <converters:FormRowTemplateSelector x:Key="FormRowTemplateSelector"
            Level3HeaderTemplate="{StaticResource Level3HeaderTemplate}"
            FileTemplate="{StaticResource FileTemplate}"
            BlankTemplate="{StaticResource BlankTemplate}"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- This section contains the flawed button styles we are reverting to -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <!-- This button was not visible in the broken state, so we use a simple command -->
            <Button Command="{Binding GoBackCommand}" Content="Back"/>
            <Button x:ConnectionId='11' x:Name="PrintButton"                           Style="{ThemeResource AccentButtonStyle}" Content="Print"/>
        </StackPanel>

        <ListView x:ConnectionId='8' x:Name="PrintableContent" Grid.Row="1" ItemsSource="{Binding FormData.Pages}" Background="Transparent"
                  SelectionMode="None" IsItemClickEnabled="False">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0,0,0,24"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate                             >
                    <StackPanel Background="White" Padding="24" BorderBrush="Gray" BorderThickness="1">
                        <!-- This Grid for the header is stable and correct -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="{Binding DataContext.FormData.OpCoHeader, ElementName=PrintableContent}" HorizontalAlignment="Center" Style="{ThemeResource HeaderTextBlockStyle}" Foreground="Black"/>
                            <TextBlock Text="Initials: _______" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}" Foreground="Black"/>
                        </Grid>

                        <Grid Background="#FFF3CF" BorderBrush="Black" BorderThickness="1,1,1,1" MinHeight="35">
                            <TextBlock Text="{Binding PageHeader}" FontWeight="Bold" Foreground="Black" Margin="8,4,8,4" VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplateSelector="{StaticResource FormRowTemplateSelector}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

