<Page
    x:Class="AIM.Views.PrintableFormPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AIM.Models"
    xmlns:converters="using:AIM.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:HeaderColorConverter x:Key="HeaderColorConverter"/>

        <!-- Level 2 Header Template -->
        <DataTemplate x:Key="Level2HeaderTemplate"                                      >
            <Grid x:ConnectionId='23' BorderBrush="Black" BorderThickness="1" Background="#FFF3CD">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <TextBlock x:ConnectionId='24' Grid.Column="2"                         FontWeight="Bold" FontSize="14" Margin="4" VerticalAlignment="Center" Foreground="Black"/>
                <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,0,1,0"/>
            </Grid>
        </DataTemplate>

        <!-- Level 3a Header Template - Green -->
        <DataTemplate x:Key="Level3aTemplate"                                      >
            <Grid x:ConnectionId='20' BorderBrush="Black" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <!-- Column 0: empty with border -->
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <!-- Columns 1-4: colored background -->
                <Grid Grid.Column="1" Grid.ColumnSpan="4" Background="#D4EDDA">
                    <TextBlock x:ConnectionId='21'                         FontWeight="SemiBold" FontSize="13" Margin="4" VerticalAlignment="Center" Foreground="Black"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Level 3b Header Template - Blue -->
        <DataTemplate x:Key="Level3bTemplate"                                      >
            <Grid x:ConnectionId='17' BorderBrush="Black" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <!-- Column 0: empty with border -->
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <!-- Columns 1-4: colored background -->
                <Grid Grid.Column="1" Grid.ColumnSpan="4" Background="#CCE5FF">
                    <TextBlock x:ConnectionId='18'                         FontWeight="SemiBold" FontSize="13" Margin="4" VerticalAlignment="Center" Foreground="Black"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Level 3c Header Template - Red -->
        <DataTemplate x:Key="Level3cTemplate"                                      >
            <Grid x:ConnectionId='14' BorderBrush="Black" BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <!-- Column 0: empty with border -->
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <!-- Columns 1-4: colored background -->
                <Grid Grid.Column="1" Grid.ColumnSpan="4" Background="#F8D7DA">
                    <TextBlock x:ConnectionId='15'                         FontWeight="SemiBold" FontSize="13" Margin="4" VerticalAlignment="Center" Foreground="Black"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- File Row Template -->
        <DataTemplate x:Key="FileTemplate"                                      >
            <Grid x:ConnectionId='11' BorderBrush="Black" BorderThickness="1" Background="White" MinHeight="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <TextBlock x:ConnectionId='12' Grid.Column="2"                         FontSize="11" Margin="4,2,4,2" VerticalAlignment="Center" Foreground="Black"/>
                <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,0,1,0"/>
            </Grid>
        </DataTemplate>

        <!-- Blank Row Template -->
        <DataTemplate x:Key="BlankTemplate">
            <Grid BorderBrush="Black" BorderThickness="1" Background="White" MinHeight="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0,0,1,0"/>
            </Grid>
        </DataTemplate>

        <!-- Page Item Template for FlipView -->
        <DataTemplate x:Key="PageTemplate"                                  >
            <Grid x:ConnectionId='3' Background="White" Margin="0" Padding="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Page Header -->
                <Border Grid.Row="0" Padding="12" BorderBrush="Black" BorderThickness="0,0,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                            <TextBlock x:ConnectionId='8'                            
                                       FontSize="22" 
                                       FontWeight="Bold"
                                                                                                                        />
                            <TextBlock Text="Inventory Summary" FontSize="12" Foreground="#666666"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Initials: __________" FontSize="11" Foreground="Black" VerticalAlignment="Top"/>
                    </Grid>
                </Border>

                <!-- Level 2 Header -->
                <Border Grid.Row="1" BorderBrush="Black" BorderThickness="1,1,1,0" Background="#FFF3CD" Padding="8">
                    <TextBlock x:ConnectionId='7'                              FontWeight="Bold" FontSize="14" Foreground="Black"/>
                </Border>

                <!-- Content Rows -->
                <ListView x:ConnectionId='4' Grid.Row="2"
                                                     
                          ItemTemplateSelector="{StaticResource RowTemplateSelector}"
                          IsItemClickEnabled="False"
                          ScrollViewer.IsVerticalRailEnabled="False"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          Margin="0"
                          Padding="0"
                          BorderBrush="Black"
                          BorderThickness="1">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <!-- Footer -->
                <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1,2,1,1" Background="#F9F9F9" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="10" Foreground="#666666" Text="Generated by AIM Inventory Management"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBlock FontSize="10" Foreground="#666666" Text="Page"/>
                            <TextBlock x:ConnectionId='5' FontSize="10" Foreground="#666666"                           />
                            <TextBlock FontSize="10" Foreground="#666666" Text="of"/>
                            <TextBlock x:ConnectionId='6' FontSize="10" Foreground="#666666"                           />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Template Selector -->
        <converters:FormRowTemplateSelector x:Key="RowTemplateSelector"
            Level2HeaderTemplate="{StaticResource Level2HeaderTemplate}"
            Level3Header_A_Template="{StaticResource Level3aTemplate}"
            Level3Header_B_Template="{StaticResource Level3bTemplate}"
            Level3Header_C_Template="{StaticResource Level3cTemplate}"
            FileTemplate="{StaticResource FileTemplate}"
            BlankTemplate="{StaticResource BlankTemplate}"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Command Bar -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Back" Label="Back" Command="{Binding GoBackCommand}"/>
            <AppBarSeparator/>
            <AppBarButton Label="Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Previous"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Next" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoToNextPage}">
                <AppBarButton.Icon>
                    <SymbolIcon Symbol="Next"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator/>
            <AppBarButton Icon="Print" Label="Print" Command="{Binding PrintCurrentPageCommand}"/>
        </CommandBar>

        <!-- FlipView for Page Navigation (No ScrollViewer!) -->
        <FlipView Grid.Row="1" 
                  ItemsSource="{Binding Pages}"
                  SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                  ItemTemplate="{StaticResource PageTemplate}"
                  Background="#F5F5F5"
                  Padding="20"
                  Visibility="{Binding CurrentPage, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
        </FlipView>

        <!-- Page Info Bar -->
        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="16" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Foreground="Black" FontSize="13" FontWeight="SemiBold" Text="Page Navigation"/>
                    <TextBlock Foreground="Black" FontSize="13" Text="{Binding CurrentPageIndex}"/>
                    <TextBlock Foreground="Black" FontSize="13" Text="of"/>
                    <TextBlock Foreground="Black" FontSize="13" Text="{Binding Pages.Count}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <Button Content="← Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}"/>
                    <Button Content="Next →" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoToNextPage}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

