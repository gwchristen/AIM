<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AIM.Views.LogViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">
                <TextBlock Text="📋 Audit Log Viewer" Style="{ThemeResource TitleTextBlockStyle}"/>

                <!-- Stats -->
                <InfoBar
                    IsOpen="True"
                    Severity="Informational"
                    Title="Log Statistics"
                    Message="{Binding LogStatsMessage}"
                    IsClosable="False"/>

                <!-- Filters -->
                <Expander Header="🔍 Filters" IsExpanded="True" Padding="12">
                    <StackPanel Spacing="12">
                        <!-- Text Search -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Search:" FontWeight="SemiBold" FontSize="12"/>
                            <TextBox
                                PlaceholderText="Search by description, path, or details..."
                                Text="{Binding FilterText, Mode=TwoWay}"
                                Width="400"/>
                        </StackPanel>

                        <!-- Filters Grid -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Action Type Filter -->
                            <StackPanel Spacing="4" Grid.Column="0">
                                <TextBlock Text="Action Type:" FontWeight="SemiBold" FontSize="12"/>
                                <ComboBox
                                    ItemsSource="{Binding AvailableActionTypes}"
                                    SelectedItem="{Binding SelectedActionTypeFilter, Mode=TwoWay}"
                                    Width="200"/>
                            </StackPanel>

                            <!-- User Filter -->
                            <StackPanel Spacing="4" Grid.Column="1">
                                <TextBlock Text="User:" FontWeight="SemiBold" FontSize="12"/>
                                <ComboBox
                                    ItemsSource="{Binding AvailableUsers}"
                                    SelectedItem="{Binding SelectedUserFilter, Mode=TwoWay}"
                                    Width="200"/>
                            </StackPanel>
                        </Grid>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="🔄 Refresh"
                                Command="{Binding LoadLogsCommand}"/>
                            <Button
                                Content="💾 Export"
                                Command="{Binding ExportLogsCommand}"/>
                            <Button
                                Content="🗑️ Clear All Logs"
                                Command="{Binding ClearAllLogsCommand}"
                                Background="Red"
                                Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Logs List -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Logs" FontWeight="SemiBold" FontSize="14"/>

                    <ListView
                        ItemsSource="{Binding FilteredLogs}"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Height="500">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12" ColumnSpacing="12" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Timestamp -->
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Timestamp" FontSize="10" Foreground="#999999"/>
                                        <TextBlock Text="{Binding Timestamp, Converter={StaticResource DateTimeConverter}}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- User -->
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="User" FontSize="10" Foreground="#999999"/>
                                        <TextBlock Text="{Binding UserId}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Action Type -->
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="Action" FontSize="10" Foreground="#999999"/>
                                        <TextBlock Text="{Binding ActionType}" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Description & Details -->
                                    <StackPanel Grid.Column="3" Spacing="4">
                                        <TextBlock Text="{Binding Description}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <StackPanel Spacing="2" Opacity="0.8">
                                            <TextBlock Text="{Binding TargetPath}" FontSize="11" Foreground="#666666" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Details}" FontSize="10" Foreground="#999999" TextWrapping="Wrap" FontFamily="Courier New"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

