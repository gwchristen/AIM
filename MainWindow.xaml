<Window
    x:Class="AIM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AIM">

    <Grid>
        <!-- THE FIX: The broken Style resource has been completely removed. -->

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="AppInfoBar"
            Grid.Row="0"
            IsOpen="False"
            HorizontalAlignment="Stretch"
            Margin="4,4,4,0"/>

        <NavigationView 
            x:Name="NavView"
            Grid.Row="1"
            Loaded="NavView_Loaded"
            ItemInvoked="NavView_ItemInvoked"
            IsBackButtonVisible="Collapsed"
            OpenPaneLength="200"
            Header="">

            <NavigationView.MenuItems>
                <!-- THE FIX: Icon properties are set directly. Foreground is set on the item. -->
                <NavigationViewItem Content="Refresh Tree" Tag="RefreshTree" Foreground="{ThemeResource SystemAccentColor}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72C;" FontSize="20"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator/>
                <NavigationViewItem Content="Browse" Tag="Browse" IsSelected="True" Foreground="{ThemeResource SystemAccentColor}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" FontSize="20"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Preview" Tag="Preview" Foreground="{ThemeResource SystemAccentColor}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FF;" FontSize="20"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="Search" Foreground="{ThemeResource SystemAccentColor}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" FontSize="20"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Scans" Tag="Scans" Foreground="{ThemeResource SystemAccentColor}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C1;" FontSize="20"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Inventory" Tag="InventoryParent" Foreground="{ThemeResource SystemAccentColor}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" FontSize="20"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Archive" Tag="InventoryArchive" Foreground="{ThemeResource SystemAccentColor}">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7B8;" FontSize="20"/>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Viewer" Tag="InventoryViewer" Foreground="{ThemeResource SystemAccentColor}">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE773;" FontSize="20"/>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Inv Admin" Tag="InventoryAdmin" Foreground="{ThemeResource SystemAccentColor}">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE90F;" FontSize="20"/>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItem Content="Stats" Tag="Stats" Foreground="{ThemeResource SystemAccentColor}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" FontSize="20"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>