<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="AIM.MainWindow"
        Title="AIM - Archive Inventory Management"
        Width="1200" Height="700"
        Icon="/Assets/avalonia-logo.ico"
        TransparencyLevelHint="AcrylicBlur"
        Background="{DynamicResource SystemControlBackgroundAltHighBrush}">

    <SplitView IsPaneOpen="True" 
               DisplayMode="Inline" 
               OpenPaneLength="220"
               CompactPaneLength="48">
        
        <!-- Navigation Pane -->
        <SplitView.Pane>
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10">
                        
                        <!-- App Title -->
                        <TextBlock Text="AIM" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Margin="16,10,16,20"
                                   Foreground="{DynamicResource SystemAccentColor}"/>
                        
                        <!-- Navigation Buttons -->
                        <Button Name="SelectRootButton" 
                                Classes="NavigationButton"
                                Click="SelectCustomRootButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10H23.21L20.93,18.5C20.7,19.37 19.92,20 19,20Z" 
                                          Width="16" Height="16"/>
                                <TextBlock Text="Select Root" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="RefreshButton" 
                                Classes="NavigationButton"
                                Command="{Binding ViewModel.RefreshTreeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" 
                                          Width="16" Height="16"/>
                                <TextBlock Text="Refresh Tree" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Separator Margin="8,8"/>
                        
                        <Button Name="BrowseButton" 
                                Classes="NavigationButton selected"
                                Click="BrowseButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M3,3H9V7H3V3M15,10H21V14H15V10M15,17H21V21H15V17M13,13H7V18H13V13Z" 
                                          Width="16" Height="16"/>
                                <TextBlock Text="Browse" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="PreviewButton" 
                                Classes="NavigationButton"
                                Click="PreviewButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z" 
                                          Width="16" Height="16"/>
                                <TextBlock Text="Preview" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="SearchButton" 
                                Classes="NavigationButton"
                                Click="SearchButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                                          Width="16" Height="16"/>
                                <TextBlock Text="Search" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="ScansButton" 
                                Classes="NavigationButton"
                                Click="ScansButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z" 
                                          Width="16" Height="16"/>
                                <TextBlock Text="Scans" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="InvArchivesButton" 
                                Classes="NavigationButton"
                                Click="InvArchivesButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M3,3H21V7H3V3M4,8H20V21H4V8M9.5,11A0.5,0.5 0 0,0 9,11.5V13H15V11.5A0.5,0.5 0 0,0 14.5,11H9.5Z" 
                                          Width="16" Height="16"/>
                                <TextBlock Text="Inv Archives" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Button Name="StatsButton" 
                                Classes="NavigationButton"
                                Click="StatsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M22,21H2V3H4V19H6V10H10V19H12V6H16V19H18V14H22V21Z" 
                                          Width="16" Height="16"/>
                                <TextBlock Text="Stats" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <Separator Margin="8,8"/>
                        
                        <Button Name="SettingsButton" 
                                Classes="NavigationButton"
                                Click="SettingsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <PathIcon Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" 
                                          Width="16" Height="16"/>
                                <TextBlock Text="Settings" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </SplitView.Pane>
        
        <!-- Content Area -->
        <SplitView.Content>
            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <ContentControl Name="MainContent" />
            </Border>
        </SplitView.Content>
        
    </SplitView>
</Window>
