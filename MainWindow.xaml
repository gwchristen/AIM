<Window
    x:Class="AIM.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="AIM">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F5F7FA" Offset="0"/>
                <GradientStop Color="#E8EBF0" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <InfoBar
            x:Name="AppInfoBar"
            Grid.Row="0"
            IsOpen="False"
            HorizontalAlignment="Stretch"
            Margin="4,4,4,0"/>

        <NavigationView 
            x:Name="NavView"
            Grid.Row="1"
            Loaded="NavView_Loaded"
            ItemInvoked="NavView_ItemInvoked"
            IsBackButtonVisible="Collapsed"
            OpenPaneLength="200"
            PaneDisplayMode="Left">
            
            <NavigationView.Resources>
                <!-- Navigation Item Styles with Color Coding -->
                <Style TargetType="NavigationViewItem">
                    <Setter Property="Margin" Value="4,2"/>
                </Style>
            </NavigationView.Resources>
            
            <NavigationView.PaneHeader>
                <Grid Height="50" Margin="8,0">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#667EEA" Offset="0"/>
                            <GradientStop Color="#764BA2" Offset="1"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <TextBlock Text="AIM" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                </Grid>
            </NavigationView.PaneHeader>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Refresh Tree" Tag="RefreshTree">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72C;" Foreground="#107C10"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator/>

                <NavigationViewItem Content="Browse" Tag="Browse" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" Foreground="#0078D4"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Preview" Tag="Preview">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FF;" Foreground="#8E8CD8"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="Search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" Foreground="#0099BC"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Scans" Tag="Scans">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7C1;" Foreground="#FF6B35"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- INVENTORY ITEM - Visibility handled in code-behind -->
                <NavigationViewItem Content="Inventory">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8B7;" Foreground="#764BA2"/>
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <NavigationViewItem Content="Admin Tools" Tag="InventoryAdminTools">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE90F;" Foreground="#FFA500"/>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Arch Viewer" Tag="InventoryViewer">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE773;" Foreground="#2B88D8"/>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <NavigationViewItem Content="Dir Analysis" Tag="DirAnalysis">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xEBE8;" Foreground="#27AE27"/>
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>

                <NavigationViewItem Content="Paperwork Forms" Tag="PaperworkForms">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE737;" Foreground="#D94F1E"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Content="Stats" Tag="Stats">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" Foreground="#667EEA"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"/>

        </NavigationView>
    </Grid>
</Window>