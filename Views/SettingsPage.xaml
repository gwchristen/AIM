<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AIM.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AIM.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="SettingsPageRoot">

	<Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Page Title -->
		<StackPanel Grid.Row="0" Margin="24,24,24,0" Spacing="8">
			<TextBlock Text="⚙️ Settings" Style="{ThemeResource TitleTextBlockStyle}"/>
			<TextBlock Text="{Binding CurrentUserId}" FontSize="12" Foreground="#666666"/>
		</StackPanel>

		<!-- TabView for Settings Sections -->
		<TabView Grid.Row="1" Margin="0,16,0,0">

			<!-- TAB 1: SECURITY SETTINGS -->
			<TabViewItem Header="🔐 Security">
				<TabViewItem.IconSource>
					<SymbolIconSource Symbol="Setting"/>
				</TabViewItem.IconSource>
				<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<StackPanel Margin="24,16,24,24" Spacing="16">

						<!-- SuperAdmin Login Section (Always Visible) -->
						<Expander Header="🔐 SuperAdmin Login" IsExpanded="True" Padding="12">
							<StackPanel Spacing="12">
								<TextBlock Text="Log in as SuperAdmin to unlock all features and manage users" FontSize="12" Foreground="#666666"/>

								<StackPanel Spacing="8">
									<TextBlock Text="Current User:" FontSize="12" FontWeight="SemiBold"/>
									<TextBlock Text="{Binding CurrentUserId}" FontSize="12" Foreground="#666666"/>
									<TextBlock Text="{Binding CurrentUserAccessLevel}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SystemAccentColor}"/>

									<StackPanel Orientation="Horizontal" Spacing="8">
										<Button
                                            Content="🔓 Login as SuperAdmin"
                                            Command="{Binding UnlockWithMasterPasswordCommand}"
                                            IsEnabled="{Binding IsMasterPasswordOverrideActive, Converter={StaticResource BoolNegationConverter}}"
                                            Style="{ThemeResource AccentButtonStyle}"/>

										<Button
                                            Content="🔒 Logout SuperAdmin"
                                            Command="{Binding DeactivateMasterPasswordOverrideCommand}"
                                            IsEnabled="{Binding IsMasterPasswordOverrideActive}"
                                            Background="Orange"/>
									</StackPanel>

									<InfoBar
                                        IsOpen="{Binding IsMasterPasswordOverrideActive}"
                                        Severity="Success"
                                        Title="✓ SuperAdmin Access Active"
                                        Message="You have full SuperAdmin access. You can manage users, edit all settings, and clear audit logs."
                                        IsClosable="False"/>

									<InfoBar
                                        IsOpen="{Binding IsMasterPasswordOverrideActive, Converter={StaticResource BoolNegationConverter}}"
                                        Severity="Informational"
                                        Title="ℹ️ SuperAdmin Login"
                                        Message="Enter the master password to gain SuperAdmin access and unlock user management features."
                                        IsClosable="True"/>
								</StackPanel>
							</StackPanel>
						</Expander>

						<!-- User Management Section (SuperAdmin Only) -->
						<Expander
                            Visibility="{Binding IsCurrentUserSuperAdmin, Converter={StaticResource BoolToVisibilityConverter}}"
                            Header="👥 User Management"
                            Padding="12"
                            IsExpanded="True">
							<StackPanel Spacing="12">
								<TextBlock Text="Manage authorized users with role-based access control" FontSize="12" Foreground="#666666"/>
								
								<TextBlock FontSize="11" Foreground="#666666">
									<Run Text="Total users: "/>
									<Run Text="{Binding DatabaseAuthorizedUsers.Count}" FontWeight="SemiBold"/>
								</TextBlock>

								<!-- Database Users List with Role Badges -->
								<ListView
                                    ItemsSource="{Binding DatabaseAuthorizedUsers}"
                                    Height="300"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    SelectionMode="None">
									<ListView.ItemTemplate>
										<DataTemplate x:DataType="local:AuthorizedUser">
											<Grid Padding="8" ColumnSpacing="8">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="2*"/>
													<ColumnDefinition Width="2*"/>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="Auto"/>
													<ColumnDefinition Width="Auto"/>
												</Grid.ColumnDefinitions>
												
												<StackPanel Grid.Column="0" VerticalAlignment="Center">
													<TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
													<TextBlock Text="{Binding FullName}" FontSize="10" Foreground="#666666" Visibility="{Binding FullName, Converter={StaticResource NullToVisibilityConverter}}"/>
												</StackPanel>
												
												<TextBlock
                                                    Text="{Binding Department}"
                                                    VerticalAlignment="Center"
                                                    Grid.Column="1"
                                                    FontSize="11"
                                                    Foreground="#666666"/>
												
												<Border
                                                    Grid.Column="2"
                                                    Background="{Binding AccessLevel, Converter={StaticResource AccessLevelColorConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
													<TextBlock
                                                        Text="{Binding AccessLevelName}"
                                                        FontSize="10"
                                                        Foreground="White"
                                                        FontWeight="SemiBold"/>
												</Border>
												
												<Button
                                                    Content="Edit"
                                                    Grid.Column="3"
                                                    Command="{Binding DataContext.EditDatabaseUserCommand, ElementName=SettingsPageRoot}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="12"
                                                    Margin="4,0"/>
												
												<Button
                                                    Content="Remove"
                                                    Grid.Column="4"
                                                    Command="{Binding DataContext.RemoveDatabaseUserCommand, ElementName=SettingsPageRoot}"
                                                    CommandParameter="{Binding}"
                                                    FontSize="12"/>
											</Grid>
										</DataTemplate>
									</ListView.ItemTemplate>
									<ListView.ItemContainerStyle>
										<Style TargetType="ListViewItem">
											<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
										</Style>
									</ListView.ItemContainerStyle>
								</ListView>

								<!-- Add/Remove User Buttons (SuperAdmin Only) -->
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Button
                                        Content="➕ Add New User"
                                        Command="{Binding AddDatabaseUserCommand}"
                                        HorizontalAlignment="Left"/>

									<Button
                                        Content="🔄 Refresh Users"
                                        Command="{Binding LoadDatabaseUsersCommand}"
                                        HorizontalAlignment="Left"/>
								</StackPanel>

								<InfoBar
                                    IsOpen="True"
                                    Severity="Informational"
                                    Title="ℹ️ Access Levels"
                                    Message="Basic (1): Can use AIM core features. Admin (2): Can manage directories and advanced features. SuperAdmin (3): Full access including user management and security settings."
                                    IsClosable="True"/>
							</StackPanel>
						</Expander>

						<!-- Master Password Management Section -->
						<Expander Header="🔑 Change Master Password" IsExpanded="False" Padding="12">
							<StackPanel Spacing="12">
								<TextBlock Text="Update the master password for SuperAdmin access" FontSize="12" Foreground="#666666"/>

								<Button
                                    Content="🔑 Change Master Password"
                                    Command="{Binding ChangeMasterPasswordCommand}"
                                    Style="{ThemeResource AccentButtonStyle}"/>

								<InfoBar
                                    IsOpen="True"
                                    Severity="Informational"
                                    Title="💡 Note"
                                    Message="You must have SuperAdmin access to change the master password."
                                    IsClosable="True"/>
							</StackPanel>
						</Expander>
					</StackPanel>
				</ScrollViewer>
			</TabViewItem>

            <!-- TAB 2: DIRECTORY SETTINGS -->
            <TabViewItem Header="📁 Directories">
                <TabViewItem.IconSource>
                    <SymbolIconSource Symbol="Folder"/>
                </TabViewItem.IconSource>
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="24,16,24,24" Spacing="16">
                            <TextBlock Text="Configure application directories" FontSize="14" FontWeight="SemiBold"/>

                            <InfoBar 
                                IsOpen="{Binding IsCurrentUserAdmin, Converter={StaticResource BoolNegationConverter}}"
                                Severity="Warning"
                                Title="🔒 Directory settings are locked"
                                Message="You need Admin or SuperAdmin access to modify directory paths. Login as SuperAdmin in the Security tab to unlock."
                                IsClosable="True"/>

                            <!-- Directory Configuration Section -->
                            <Expander Header="📂 Directory Configuration" IsExpanded="True" Padding="12">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Configure paths for application data storage" FontSize="12" Foreground="#666666"/>

                                    <!-- Root Directory -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Default Root Directory" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Default location for file browsing operations" FontSize="11" Foreground="#666666"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox 
                                                Text="{Binding DefaultRootDirectory, Mode=TwoWay}" 
                                                Width="400" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                PlaceholderText="Select root directory"/>
                                            <Button 
                                                Click="BrowseRootDirectory_Click" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                                                    <TextBlock Text="Browse"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Archive Path -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Archive Path" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Location where archived files are stored" FontSize="11" Foreground="#666666"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox 
                                                Text="{Binding ArchivePath, Mode=TwoWay}" 
                                                Width="400" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                PlaceholderText="Select archive path"/>
                                            <Button 
                                                Click="BrowseArchivePath_Click" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                                                    <TextBlock Text="Browse"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Shipped Directory -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Shipped Directory" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Directory path for shipped items" FontSize="11" Foreground="#666666"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox 
                                                Text="{Binding ShippedDirectory, Mode=TwoWay}" 
                                                Width="400" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                PlaceholderText="Select shipped directory"/>
                                            <Button 
                                                Click="BrowseShippedDirectory_Click" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                                                    <TextBlock Text="Browse"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- File Scans Directory -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="File Scans Directory" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Directory where file scan results are stored" FontSize="11" Foreground="#666666"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox 
                                                Text="{Binding FileScansDirectory, Mode=TwoWay}" 
                                                Width="400" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                PlaceholderText="Select file scans directory"/>
                                            <Button 
                                                Click="BrowseFileScansDirectory_Click" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                                                    <TextBlock Text="Browse"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Inventory Archive Directory -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Inventory Archive Directory" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Directory where inventory archives are stored" FontSize="11" Foreground="#666666"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox 
                                                Text="{Binding InventoryArchiveDirectory, Mode=TwoWay}" 
                                                Width="400" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                PlaceholderText="Select inventory archive directory"/>
                                            <Button 
                                                Click="BrowseInventoryArchiveDirectory_Click" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                                                    <TextBlock Text="Browse"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Save Button -->
                                    <Button 
                                        Click="SaveButton_Click" 
                                        Style="{ThemeResource AccentButtonStyle}"
                                        IsEnabled="{Binding IsCurrentUserAdmin}"
                                        Width="200">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                                            <TextBlock Text="Save Directory Settings"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>

                            <!-- Database Configuration Section -->
                            <Expander Header="🗄️ Database Configuration" IsExpanded="True" Padding="12">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Configure security database location" FontSize="12" Foreground="#666666"/>

                                    <!-- Security Database Path -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Security Database Path" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Location of the centralized SQLite security database for user management" FontSize="11" Foreground="#666666"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox 
                                                Text="{Binding SecurityDatabasePath, Mode=TwoWay}" 
                                                Width="400" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                PlaceholderText="Select security database path (e.g., \\server\shared\AIM\security.db)"/>
                                            <Button 
                                                Click="BrowseSecurityDatabasePath_Click" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                                                    <TextBlock Text="Browse"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <InfoBar 
                                            IsOpen="True"
                                            Severity="Warning"
                                            Title="💡 Shared Database"
                                            Message="Point this to a shared network location (e.g., \\server\shared\AIM\security.db) to enable centralized user management across all AIM instances."
                                            IsClosable="True"/>
                                    </StackPanel>

                                    <!-- Security Configuration Path -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Security Config Storage Path" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="Location for encrypted master password and configuration" FontSize="11" Foreground="#666666"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBox 
                                                Text="{Binding SecurityConfigPath, Mode=TwoWay}" 
                                                Width="400" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                PlaceholderText="Select security config storage path (leave blank for local AppData)"/>
                                            <Button 
                                                Click="BrowseSecurityConfigPath_Click" 
                                                IsEnabled="{Binding IsCurrentUserAdmin}"
                                                VerticalAlignment="Bottom">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                                                    <TextBlock Text="Browse"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <InfoBar 
                                            IsOpen="True"
                                            Severity="Informational"
                                            Title="💡 Optional Configuration"
                                            Message="Leave blank to use local AppData. Point to a shared drive to sync master password across computers."
                                            IsClosable="True"/>
                                    </StackPanel>

                                    <!-- Save Button -->
                                    <Button 
                                        Click="SaveButton_Click" 
                                        Style="{ThemeResource AccentButtonStyle}"
                                        IsEnabled="{Binding IsCurrentUserAdmin}"
                                        Width="200">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                                            <TextBlock Text="Save Database Settings"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabViewItem>

            <!-- TAB 3: AUDIT LOGS -->
			<TabViewItem Header="📋 Audit Logs">
				<TabViewItem.IconSource>
					<SymbolIconSource Symbol="Document"/>
				</TabViewItem.IconSource>
				<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
					<StackPanel Margin="24,16,24,24" Spacing="16">
						<TextBlock Text="📋 Audit Log Viewer" Style="{ThemeResource SubtitleTextBlockStyle}"/>

						<!-- Stats -->
						<InfoBar
                            IsOpen="True"
                            Severity="Informational"
                            Title="Log Statistics"
                            Message="{Binding LogStatsMessage}"
                            IsClosable="False"/>

						<!-- Filters -->
						<Expander Header="🔍 Filters" IsExpanded="True" Padding="12">
							<StackPanel Spacing="12">
								<!-- Text Search -->
								<StackPanel Spacing="4">
									<TextBlock Text="Search:" FontWeight="SemiBold" FontSize="12"/>
									<TextBox
                                        PlaceholderText="Search by description, path, or details..."
                                        Text="{Binding FilterText, Mode=TwoWay}"
                                        Width="400"/>
								</StackPanel>

								<!-- Filters Grid -->
								<Grid ColumnSpacing="16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>

									<!-- Action Type Filter -->
									<StackPanel Spacing="4" Grid.Column="0">
										<TextBlock Text="Action Type:" FontWeight="SemiBold" FontSize="12"/>
										<ComboBox
                                            ItemsSource="{Binding AvailableActionTypes}"
                                            SelectedItem="{Binding SelectedActionTypeFilter, Mode=TwoWay}"
                                            Width="200"/>
									</StackPanel>

									<!-- User Filter -->
									<StackPanel Spacing="4" Grid.Column="1">
										<TextBlock Text="User:" FontWeight="SemiBold" FontSize="12"/>
										<ComboBox
                                            ItemsSource="{Binding AvailableUsers}"
                                            SelectedItem="{Binding SelectedUserFilter, Mode=TwoWay}"
                                            Width="200"/>
									</StackPanel>
								</Grid>

								<!-- Action Buttons -->
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Button
                                        Content="🔄 Refresh"
                                        Command="{Binding LoadLogsCommand}"/>
									<Button
                                        Content="💾 Export"
                                        Command="{Binding ExportLogsCommand}"/>
									<Button
                                        Content="🗑️ Clear All Logs"
                                        Command="{Binding ClearAllLogsCommand}"
                                        IsEnabled="{Binding IsUserAuthorized}"
                                        Background="Red"
                                        Foreground="White"/>
								</StackPanel>

								<!-- Security Notice -->
								<InfoBar
                                    IsOpen="True"
                                    Severity="Warning"
                                    Title="🔐 Audit Logs are Protected"
                                    Message="Only authorized users can clear audit logs. All log clearing attempts are recorded."
                                    IsClosable="True"/>
							</StackPanel>
						</Expander>

						<!-- Logs List -->
						<StackPanel Spacing="8">
							<TextBlock Text="Logs" FontWeight="SemiBold" FontSize="14"/>

							<ListView
                                ItemsSource="{Binding FilteredLogs}"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Height="500">

								<ListView.ItemTemplate>
									<DataTemplate>
										<Grid Padding="12" ColumnSpacing="12" BorderBrush="#EEEEEE" BorderThickness="0,0,0,1">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="180"/>
												<ColumnDefinition Width="120"/>
												<ColumnDefinition Width="150"/>
												<ColumnDefinition Width="*"/>
											</Grid.ColumnDefinitions>

											<!-- Timestamp -->
											<StackPanel Grid.Column="0" Spacing="2">
												<TextBlock Text="Timestamp" FontSize="10" Foreground="#999999"/>
												<TextBlock Text="{Binding Timestamp, Converter={StaticResource DateTimeConverter}}" FontSize="12" TextWrapping="Wrap"/>
											</StackPanel>

											<!-- User -->
											<StackPanel Grid.Column="1" Spacing="2">
												<TextBlock Text="User" FontSize="10" Foreground="#999999"/>
												<TextBlock Text="{Binding UserId}" FontSize="12" TextWrapping="Wrap"/>
											</StackPanel>

											<!-- Action Type -->
											<StackPanel Grid.Column="2" Spacing="2">
												<TextBlock Text="Action" FontSize="10" Foreground="#999999"/>
												<TextBlock Text="{Binding ActionType}" FontSize="12" TextWrapping="Wrap"/>
											</StackPanel>

											<!-- Description & Details -->
											<StackPanel Grid.Column="3" Spacing="4">
												<TextBlock Text="{Binding Description}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
												<StackPanel Spacing="2" Opacity="0.8">
													<TextBlock Text="{Binding TargetPath}" FontSize="11" Foreground="#666666" TextWrapping="Wrap"/>
													<TextBlock Text="{Binding Details}" FontSize="10" Foreground="#999999" TextWrapping="Wrap" FontFamily="Courier New"/>
												</StackPanel>
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ListView.ItemTemplate>

								<ListView.ItemContainerStyle>
									<Style TargetType="ListViewItem">
										<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
										<Setter Property="Padding" Value="0"/>
									</Style>
								</ListView.ItemContainerStyle>
							</ListView>
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</TabViewItem>

            <!-- TAB 4: THEME SETTINGS -->
            <TabViewItem Header="🎨 Theme">
                <TabViewItem.IconSource>
                    <SymbolIconSource Symbol="Favorite"/>
                </TabViewItem.IconSource>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,16,24,24" Spacing="16">
                        <TextBlock Text="Customize Application Appearance" FontSize="14" FontWeight="SemiBold"/>

                        <!-- Theme Selection -->
                        <Expander Header="🎭 Application Theme" IsExpanded="True" Padding="12">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Choose how the app should look" FontSize="12" Foreground="#666666"/>

                                <ComboBox
                                        x:Name="ThemeComboBox"
                                        ItemsSource="{Binding AvailableThemes}"
                                        SelectedItem="{Binding SelectedThemeName, Mode=OneWay}"
                                        SelectionChanged="ThemeComboBox_SelectionChanged"
                                        Width="300"
                                        PlaceholderText="Select theme"/>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Theme Options:" FontSize="11" FontWeight="SemiBold" Foreground="#666666"/>
                                    <StackPanel Spacing="4" Margin="0,0,0,8">
                                        <TextBlock Text="• Follow Windows Theme - Automatically matches your Windows theme setting" FontSize="11"/>
                                        <TextBlock Text="• Light - Bright, clean interface" FontSize="11"/>
                                        <TextBlock Text="• Dark - Easy on the eyes in low light" FontSize="11"/>
                                        <TextBlock Text="• High Contrast - Enhanced visibility for accessibility" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>

                                <InfoBar 
                                        IsOpen="True"
                                        Severity="Informational"
                                        Title="💡 Note"
                                        Message="The app will apply your theme preference immediately. Changes are saved automatically."
                                        IsClosable="True"/>
                            </StackPanel>
                        </Expander>

                        <!-- Accent Color -->
                        <Expander Header="🎨 Windows Accent Color" IsExpanded="True" Padding="12">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Current Windows accent color" FontSize="12" Foreground="#666666"/>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Color Preview -->
                                    <StackPanel Grid.Column="0" Spacing="8">
                                        <TextBlock Text="Preview:" FontSize="11" FontWeight="SemiBold"/>
                                        <Border 
                                                Width="100" 
                                                Height="100" 
                                                CornerRadius="8"
                                                BorderBrush="{ThemeResource SystemAccentColor}"
                                                BorderThickness="2">
                                            <Border.Background>
                                                <SolidColorBrush Color="{ThemeResource SystemAccentColor}"/>
                                            </Border.Background>
                                        </Border>
                                    </StackPanel>

                                    <!-- Color Details -->
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Hex Code:" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding AccentColorHex}" FontSize="12" FontFamily="Courier New"/>
                                        <Button 
                                                Content="🔄 Refresh from Windows" 
                                                Command="{Binding RefreshAccentColorCommand}"
                                                Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <InfoBar 
                                        IsOpen="True"
                                        Severity="Informational"
                                        Title="💡 Synced with Windows"
                                        Message="The app uses your Windows accent color for highlights and buttons. Change your Windows Settings > Personalization > Colors to customize the accent color."
                                        IsClosable="True"/>
                            </StackPanel>
                        </Expander>

                        <!-- Accessibility -->
                        <Expander Header="♿ Accessibility" IsExpanded="True" Padding="12">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Accessibility Information" FontSize="12" Foreground="#666666"/>

                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="High Contrast Mode:" Grid.Column="0" FontWeight="SemiBold"/>
                                        <TextBlock 
                                                Text="{Binding IsHighContrast}" 
                                                Grid.Column="1"
                                                Foreground="{ThemeResource SystemAccentColor}"/>
                                    </Grid>
                                </StackPanel>

                                <InfoBar 
                                        IsOpen="{Binding IsHighContrast}"
                                        Severity="Informational"
                                        Title="✓ High Contrast Enabled"
                                        Message="You have Windows High Contrast mode enabled. The app will use enhanced visibility colors."
                                        IsClosable="True"/>

                                <TextBlock Text="This app is designed to be accessible. If you experience any accessibility issues, please report them." FontSize="11" TextWrapping="Wrap" Foreground="#666666"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView>
	</Grid>
</Page>