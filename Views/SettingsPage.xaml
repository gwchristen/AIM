<Page
    x:Class="AIM.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ScrollViewer>
		<StackPanel Margin="10">
			<TextBlock Text="Settings" FontSize="24" Margin="0,0,0,20"/>
			<StackPanel Orientation="Horizontal" Margin="0,5,0,15">
				<TextBlock Text="Password: " VerticalAlignment="Center"/>
				<Button Content="Change Password" Click="ChangePasswordClicked"/>
				<Button Content="Unlock" Click="UnlockClicked" Margin="5,0,0,0"/>
				<Button Content="Lock" Click="LockClicked" Margin="5,0,0,0" IsEnabled="{Binding IsUnlocked}"/>
			</StackPanel>
			<TextBlock Text="Archive Directory:" />
			<StackPanel Orientation="Horizontal" Margin="0,5,0,15">
				<TextBox x:Name="ArchiveTextBox" Text="{Binding MainViewModel.ArchivePath, Mode=TwoWay}" Width="300"/>
				<Button Content="Browse" Click="BrowseArchiveClicked" IsEnabled="{Binding IsUnlocked}" Margin="5,0,0,0"/>
			</StackPanel>
			<TextBlock Text="Default Root Directory:" />
			<StackPanel Orientation="Horizontal" Margin="0,5,0,15">
				<TextBox x:Name="DefaultRootTextBox" Text="{Binding MainViewModel.DefaultRootDirectory, Mode=TwoWay}" Width="300"/>
				<Button Content="Browse" Click="BrowseDefaultRootClicked" IsEnabled="{Binding IsUnlocked}" Margin="5,0,0,0"/>
			</StackPanel>
			<TextBlock Text="Shipped Directory:" />
			<StackPanel Orientation="Horizontal" Margin="0,5,0,15">
				<TextBox x:Name="ShippedTextBox" Text="{Binding MainViewModel.ShippedDirectory, Mode=TwoWay}" Width="300"/>
				<Button Content="Browse" Click="BrowseShippedClicked" IsEnabled="{Binding IsUnlocked}" Margin="5,0,0,0"/>
			</StackPanel>
			<TextBlock Text="File Scans Directory:" />
			<StackPanel Orientation="Horizontal" Margin="0,5,0,15">
				<TextBox Text="{Binding MainViewModel.FileScansDirectory, Mode=TwoWay}" Width="300"/>
				<Button Content="Browse" Click="BrowseFileScansClicked" Margin="5,0,0,0"/>
			</StackPanel>
			<TextBlock Text="Inventory Archive Directory:" />
			<StackPanel Orientation="Horizontal" Margin="0,5,0,0">
				<TextBox x:Name="InventoryArchiveTextBox" Text="{Binding MainViewModel.InventoryArchiveDirectory, Mode=TwoWay}" Width="300"/>
				<Button Content="Browse" Click="BrowseInventoryArchiveClicked" IsEnabled="{Binding IsUnlocked}" Margin="5,0,0,0"/>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</Page>