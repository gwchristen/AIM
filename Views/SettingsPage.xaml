<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AIM.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Title -->
        <StackPanel Grid.Row="0" Margin="24,24,24,0" Spacing="8">
            <TextBlock Text="⚙️ Settings" Style="{ThemeResource TitleTextBlockStyle}"/>
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" Margin="24,16,24,24" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24">

                <!-- Directory Settings Section -->
                <StackPanel Spacing="16">
                    <TextBlock Text="📁 Directory Settings" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    
                    <!-- Default Root Directory -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Default Root Directory" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding DefaultRootDirectory, Mode=TwoWay}" IsEnabled="{Binding AreDirectoryControlsEnabled}" />
                            <Button Grid.Column="1" Content="Browse" Command="{Binding SelectDefaultRootDirectoryCommand}" IsEnabled="{Binding AreDirectoryControlsEnabled}" />
                        </Grid>
                    </StackPanel>

                    <!-- Archive Path -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Archive Path" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ArchivePath, Mode=TwoWay}" IsEnabled="{Binding AreDirectoryControlsEnabled}" />
                            <Button Grid.Column="1" Content="Browse" Command="{Binding SelectArchivePathCommand}" IsEnabled="{Binding AreDirectoryControlsEnabled}" />
                        </Grid>
                    </StackPanel>

                    <!-- Shipped Directory -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Shipped Directory" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ShippedDirectory, Mode=TwoWay}" IsEnabled="{Binding AreDirectoryControlsEnabled}" />
                            <Button Grid.Column="1" Content="Browse" Command="{Binding SelectShippedDirectoryCommand}" IsEnabled="{Binding AreDirectoryControlsEnabled}" />
                        </Grid>
                    </StackPanel>

                    <!-- File Scans Directory -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="File Scans Directory" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding FileScansDirectory, Mode=TwoWay}" IsEnabled="{Binding AreDirectoryControlsEnabled}" />
                            <Button Grid.Column="1" Content="Browse" Command="{Binding SelectFileScansDirectoryCommand}" IsEnabled="{Binding AreDirectoryControlsEnabled}" />
                        </Grid>
                    </StackPanel>

                    <!-- Inventory Archive Directory -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Inventory Archive Directory" FontWeight="SemiBold"/>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding InventoryArchiveDirectory, Mode=TwoWay}" IsEnabled="{Binding AreDirectoryControlsEnabled}" />
                            <Button Grid.Column="1" Content="Browse" Command="{Binding SelectInventoryArchiveDirectoryCommand}" IsEnabled="{Binding AreDirectoryControlsEnabled}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- Theme Settings Section -->
                <StackPanel Spacing="16">
                    <TextBlock Text="🎨 Theme" Style="{ThemeResource SubtitleTextBlockStyle}"/>
                    <ComboBox 
                        Header="Select Theme"
                        SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                        Width="250"
                        HorizontalAlignment="Left">
                        <x:String>FollowSystem</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                        <x:String>HighContrast</x:String>
                    </ComboBox>
                </StackPanel>

                <!-- Save Button -->
                <Button 
                    Content="💾 Save Settings" 
                    Command="{Binding SaveSettingsCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Left"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
