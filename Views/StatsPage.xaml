<Page
    x:Class="AIM.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AIM.Models"
    xmlns:viewmodels="using:AIM.ViewModels"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:StatsViewModel}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
            <Border Background="{StaticResource PrimaryGradientBrush}" 
                    CornerRadius="8" 
                    Padding="16,8">
                <TextBlock Text="Statistics" 
                           Style="{ThemeResource TitleTextBlockStyle}"
                           Foreground="White"
                           FontWeight="Bold"/>
            </Border>
            <Button Command="{Binding LoadStatsCommand}" 
                    Margin="24,0,0,0" 
                    VerticalAlignment="Center"
                    CornerRadius="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Refresh" Foreground="{StaticResource SuccessBrush}"/>
                    <TextBlock Text="Refresh"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- THE FIX: Added HorizontalAlignment="Center" to this StackPanel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24" HorizontalAlignment="Center">
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{StaticResource PrimaryBrush}" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    MinWidth="200" 
                    Padding="16">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <StackPanel Spacing="4">
                    <TextBlock Text="Total Files" 
                               Style="{ThemeResource CaptionTextBlockStyle}" 
                               Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalFileCount, Mode=OneWay}" 
                               Style="{ThemeResource SubtitleTextBlockStyle}" 
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource PrimaryDarkBrush}"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{StaticResource SecondaryBrush}" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    MinWidth="200" 
                    Padding="16">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <StackPanel Spacing="4">
                    <TextBlock Text="Total Devices" 
                               Style="{ThemeResource CaptionTextBlockStyle}" 
                               Foreground="{StaticResource SecondaryBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalDeviceCount, Mode=OneWay}" 
                               Style="{ThemeResource SubtitleTextBlockStyle}" 
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource SecondaryDarkBrush}"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                    BorderBrush="{StaticResource ErrorBrush}" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    MinWidth="200" 
                    Padding="16">
                <Border.Shadow>
                    <ThemeShadow/>
                </Border.Shadow>
                <StackPanel Spacing="4">
                    <TextBlock Text="Problematic Files" 
                               Style="{ThemeResource CaptionTextBlockStyle}" 
                               Foreground="{StaticResource ErrorBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ProblematicFileCount, Mode=OneWay}" 
                               Style="{ThemeResource SubtitleTextBlockStyle}" 
                               Foreground="{StaticResource ErrorBrush}" 
                               HorizontalAlignment="Center"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="16">
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{StaticResource SecondaryBrush}" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="8">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <StackPanel>
                        <TextBlock Text="Files by OpCo" 
                                   Style="{ThemeResource SubtitleTextBlockStyle}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,4"
                                   Foreground="{StaticResource SecondaryDarkBrush}"
                                   FontWeight="SemiBold"/>
                        <lvc:PieChart
                            x:Name="FileChart"
                            Height="180"
                            Width="325"
                            Series="{Binding OpCoFileSeries, Mode=OneWay}"
                            LegendPosition="Bottom"
                            LegendTextSize="12"
                            Background="Transparent"/>
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{StaticResource AccentBrush}" 
                        BorderThickness="2" 
                        CornerRadius="8" 
                        Padding="8">
                    <Border.Shadow>
                        <ThemeShadow/>
                    </Border.Shadow>
                    <StackPanel>
                        <TextBlock Text="Devices by OpCo" 
                                   Style="{ThemeResource SubtitleTextBlockStyle}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,4"
                                   Foreground="{StaticResource AccentDarkBrush}"
                                   FontWeight="SemiBold"/>
                        <lvc:PieChart
                            x:Name="DeviceChart"
                            Height="180"
                            Width="325"
                            Series="{Binding OpCoDeviceSeries, Mode=OneWay}"
                            LegendPosition="Bottom"
                            LegendTextSize="12"
                            Background="Transparent"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Files with Lines !=17 Characters (Double-click to Preview)" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                <ListView x:Name="ProblematicFilesListView" Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding ProblematicFiles, Mode=OneWay}" IsItemClickEnabled="True" DoubleTapped="ProblematicFilesListView_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ProblematicFile">
                            <TextBlock Text="{x:Bind Path}" ToolTipService.ToolTip="{x:Bind Path}" Padding="0,8"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>