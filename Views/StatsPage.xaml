<Page
    x:Class="AIM.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Stats Display -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Totale Inventory Count" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding TotalTextFilesText}"/>
            <TextBlock Text="{Binding TotalLinesText}"/>
            <TextBlock Text="OpCo Inventory Stats" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding OhioFilesText}"/>
            <TextBlock Text="{Binding OhioLinesText}"/>
            <TextBlock Text="{Binding ImFilesText}"/>
            <TextBlock Text="{Binding ImLinesText}"/>
        </StackPanel>

        <!-- Problematic Files -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Files with Lines &lt;17 Characters (Double-click to Preview)" FontSize="16" FontWeight="SemiBold"/>
            <ListBox ItemsSource="{Binding ProblematicFiles}" DoubleTapped="ListBox_DoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Path}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Page>