<Page
    x:Class="AIM.Views.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AIM.Models"
    xmlns:viewmodels="using:AIM.ViewModels"
    xmlns:converters="using:AIM.Converters"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>

        <SolidColorBrush x:Key="StatsAccentColor" Color="#3F51B5"/>
        <SolidColorBrush x:Key="FilesColor" Color="#0078D4"/>
        <SolidColorBrush x:Key="DevicesColor" Color="#107C10"/>
        <SolidColorBrush x:Key="ProblematicColor" Color="#C42B1C"/>

        <!-- Context Menu -->
        <MenuFlyout x:Key="FileContextMenu">
            <MenuFlyoutItem Text="Preview File" Click="ContextMenu_Preview_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8FF;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Open File Location" Click="ContextMenu_OpenLocation_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8DA;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Copy Path" Click="ContextMenu_CopyPath_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE9D9;" FontSize="28" Foreground="{StaticResource StatsAccentColor}"/>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Statistics" Style="{ThemeResource TitleTextBlockStyle}"/>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" 
                                          Width="20" Height="20"
                                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SourceDirectoryText, Mode=OneWay}" 
                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                   Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>

                <!-- Header Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <!-- Last Refreshed -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.HasLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE823;" FontSize="12" Opacity="0.6"/>
                        <TextBlock Text="{x:Bind ViewModel.LastRefreshedText, Mode=OneWay}" FontSize="12" Opacity="0.6"/>
                    </StackPanel>

                    <AppBarSeparator Margin="4,0" 
                                     Visibility="{x:Bind ViewModel.HasLoaded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Command="{x:Bind ViewModel.LoadStatsCommand}"
                            IsEnabled="{x:Bind ViewModel. IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                            ToolTipService.ToolTip="Refresh statistics">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                            <TextBlock Text="Refresh"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.ExportProblematicFilesCommand}"
                            IsEnabled="{x:Bind ViewModel. HasProblematicFiles, Mode=OneWay}"
                            ToolTipService.ToolTip="Export problematic files list">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B5;" FontSize="14"/>
                            <TextBlock Text="Export"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,16,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Loading State -->
                <Border Grid.Row="0" Grid.RowSpan="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="40"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <ProgressRing IsActive="True" Width="48" Height="48"/>
                        <TextBlock Text="{x:Bind ViewModel.LoadingText, Mode=OneWay}" FontSize="14" Opacity="0.7" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Error State -->
                <Border Grid.Row="0" Grid.RowSpan="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{StaticResource ProblematicColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="40"
                        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="{StaticResource ProblematicColor}"/>
                        <TextBlock Text="Unable to load statistics" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" 
                                   FontSize="13" Opacity="0.7" 
                                   TextWrapping="Wrap" 
                                   MaxWidth="400" 
                                   TextAlignment="Center"/>
                        <Button Content="Retry" Command="{x:Bind ViewModel.LoadStatsCommand}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- No Directory State -->
                <Border Grid.Row="0" Grid.RowSpan="3"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="40"
                        Visibility="{x:Bind ViewModel.ShowNoDirectory, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                        <FontIcon Glyph="&#xE8B7;" FontSize="48" Opacity="0.3"/>
                        <TextBlock Text="No Root Directory Configured" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Opacity="0.7"/>
                        <TextBlock Text="Please configure a default root directory in Settings to view statistics." 
                                   FontSize="13" Opacity="0.5" 
                                   TextWrapping="Wrap" 
                                   MaxWidth="400" 
                                   TextAlignment="Center"/>
                        <Button Content="Open Settings" Command="{x:Bind ViewModel.OpenSettingsCommand}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Results (visible when loaded) -->
                <StackPanel Grid.Row="0" Grid.RowSpan="3" 
                            Spacing="16"
                            Visibility="{x:Bind ViewModel.ShowResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">

                    <!-- Summary Cards -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Total Files Card -->
                        <Border Grid.Column="0"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{StaticResource FilesColor}"
                                BorderThickness="0,3,0,0"
                                CornerRadius="8"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" 
                                        Background="{StaticResource FilesColor}" 
                                        CornerRadius="8" 
                                        Width="48" Height="48"
                                        Margin="0,0,16,0">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Total Files" FontSize="13" Opacity="0.6"/>
                                        <TextBlock Text="{x:Bind ViewModel.TotalFileCountText, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/>
                                    </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Total Devices Card -->
                        <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{StaticResource DevicesColor}"
                                BorderThickness="0,3,0,0"
                                CornerRadius="8"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Background="{StaticResource DevicesColor}" 
                                        CornerRadius="8" 
                                        Width="48" Height="48"
                                        Margin="0,0,16,0">
                                    <FontIcon Glyph="&#xE772;" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Total Devices" FontSize="13" Opacity="0.6"/>
                                    <TextBlock Text="{x:Bind ViewModel.TotalDeviceCountText, Mode=OneWay}" FontSize="28" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Problematic Files Card -->
                        <Border Grid.Column="2"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{x:Bind ViewModel.ProblematicBorderColor, Mode=OneWay}"
                                BorderThickness="0,3,0,0"
                                CornerRadius="8"
                                Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" 
                                        Background="{x:Bind ViewModel.ProblematicBorderColor, Mode=OneWay}" 
                                        CornerRadius="8" 
                                        Width="48" Height="48"
                                        Margin="0,0,16,0">
                                        <FontIcon Glyph="{x:Bind ViewModel.ProblematicIcon, Mode=OneWay}" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Problematic Files" FontSize="13" Opacity="0.6"/>
                                        <TextBlock Text="{x:Bind ViewModel. ProblematicFileCountText, Mode=OneWay}" 
                                               FontSize="28" 
                                               FontWeight="SemiBold"
                                               Foreground="{x:Bind ViewModel. ProblematicTextColor, Mode=OneWay}"/>
                                    </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Charts and Problematic Files -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                            <!-- Charts Column -->
                            <StackPanel Grid.Column="0" Spacing="16">
                                <!-- Files by OpCo Chart -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{StaticResource FilesColor}"/>
                                            <TextBlock Text="Files by OpCo" FontWeight="SemiBold" FontSize="14"/>
                                        </StackPanel>

                                        <!-- Empty State -->
                                        <StackPanel Visibility="{x:Bind ViewModel.HasNoChartData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                HorizontalAlignment="Center"
                                                Spacing="8"
                                                Padding="40,20">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="32" Opacity="0.3"/>
                                            <TextBlock Text="No data available" FontSize="12" Opacity="0.5" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <lvc:PieChart
                                        x:Name="FileChart"
                                        Height="200"
                                        Width="340"
                                        Series="{x:Bind ViewModel.OpCoFileSeries, Mode=OneWay}"
                                        LegendPosition="Bottom"
                                        LegendTextSize="11"
                                        Background="Transparent"
                                        Visibility="{x:Bind ViewModel.HasNoChartData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Devices by OpCo Chart -->
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE772;" FontSize="16" Foreground="{StaticResource DevicesColor}"/>
                                            <TextBlock Text="Devices by OpCo" FontWeight="SemiBold" FontSize="14"/>
                                        </StackPanel>

                                        <!-- Empty State -->
                                        <StackPanel Visibility="{x:Bind ViewModel.HasNoChartData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                HorizontalAlignment="Center"
                                                Spacing="8"
                                                Padding="40,20">
                                            <FontIcon Glyph="&#xE9D9;" FontSize="32" Opacity="0.3"/>
                                            <TextBlock Text="No data available" FontSize="12" Opacity="0.5" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <lvc:PieChart
                                        x:Name="DeviceChart"
                                        Height="200"
                                        Width="340"
                                        Series="{x:Bind ViewModel. OpCoDeviceSeries, Mode=OneWay}"
                                        LegendPosition="Bottom"
                                        LegendTextSize="11"
                                        Background="Transparent"
                                        Visibility="{x:Bind ViewModel. HasNoChartData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Problematic Files Column -->
                            <Border Grid.Column="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                        <!-- Section Header -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{StaticResource ProblematicColor}"/>
                                            <TextBlock Text="Files with Invalid Line Lengths" FontWeight="SemiBold" FontSize="14"/>
                                            <Border Background="{x:Bind ViewModel.ProblematicBadgeColor, Mode=OneWay}"
                                                CornerRadius="10"
                                                Padding="8,2"
                                                VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind ViewModel.ProblematicFileCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Empty State (No Problems = Good!) -->
                                        <StackPanel Grid.Row="1"
                                            Visibility="{x:Bind ViewModel. HasNoProblematicFiles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="12"
                                            Padding="40">
                                            <FontIcon Glyph="&#xE73E;" FontSize="48" Foreground="{StaticResource DevicesColor}"/>
                                            <TextBlock Text="All files are valid!" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource DevicesColor}"/>
                                            <TextBlock Text="No files with invalid line lengths were found." 
                                               FontSize="13" Opacity="0.6" 
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Problematic Files List -->
                                        <ListView x:Name="ProblematicFilesListView" 
                                          Grid.Row="1"
                                          ItemsSource="{x:Bind ViewModel.ProblematicFiles, Mode=OneWay}" 
                                          IsItemClickEnabled="True" 
                                          SelectionMode="Single"
                                          DoubleTapped="ProblematicFilesListView_DoubleTapped"
                                          RightTapped="ProblematicFilesListView_RightTapped"
                                          Visibility="{x:Bind ViewModel.HasProblematicFiles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="models:ProblematicFile">
                                                    <Grid Padding="8,12" ToolTipService.ToolTip="{x:Bind Path}">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <FontIcon Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                                                          Glyph="&#xE8A5;" 
                                                          FontSize="16" 
                                                          Foreground="{StaticResource ProblematicColor}"
                                                          Margin="0,0,12,0"
                                                          VerticalAlignment="Center"/>

                                                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                                           Text="{x:Bind FileName}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" 
                                                           Text="{x:Bind Directory}" 
                                                           FontSize="11" 
                                                           Opacity="0.5"
                                                           TextTrimming="CharacterEllipsis"/>

                                                        <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" 
                                                           Text="{x:Bind SizeText}" 
                                                           FontSize="11" 
                                                           Opacity="0.6"
                                                           VerticalAlignment="Center"
                                                           Margin="12,0,0,0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                </Grid>
                            </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>