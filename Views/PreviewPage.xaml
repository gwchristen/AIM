<Page
    x:Class="AIM.Views.PreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:converters="using:AIM.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToTextWrappingConverter x:Key="BoolToTextWrappingConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <SolidColorBrush x:Key="PreviewAccentColor" Color="#0078D4"/>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="S" Modifiers="Control" Invoked="SaveAccelerator_Invoked"/>
        <KeyboardAccelerator Key="O" Modifiers="Control" Invoked="OpenAccelerator_Invoked"/>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FindAccelerator_Invoked"/>
        <KeyboardAccelerator Key="G" Modifiers="Control" Invoked="GoToLineAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Escape" Invoked="EscapeAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <Button x:Name="GoBackButton" 
                        Grid.Column="0" 
                        VerticalAlignment="Center" 
                        Margin="0,0,16,0" 
                        Click="GoBackButton_Click"
                        ToolTipService.ToolTip="Go back (Escape)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="16"/>
                        <TextBlock Text="Back"/>
                    </StackPanel>
                </Button>

                <!-- File Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="{x:Bind ViewModel. FileIcon, Mode=OneWay}" 
                                  FontSize="24" 
                                  Foreground="{StaticResource PreviewAccentColor}"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind ViewModel. FileName, Mode=OneWay}" 
                                           Style="{ThemeResource SubtitleTextBlockStyle}"/>
                                <TextBlock Text="●" 
                                           Foreground="{ThemeResource SystemAccentColor}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           ToolTipService.ToolTip="Unsaved changes"
                                           Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Border Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        Visibility="{x:Bind ViewModel.IsReadOnly, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Read Only" FontSize="11"/>
                                </Border>
                                <Border Background="{StaticResource PreviewAccentColor}"
                                        CornerRadius="4"
                                        Padding="8,2"
                                        Visibility="{x:Bind ViewModel.IsExternalFile, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="External" FontSize="11" Foreground="White"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock Text="{x:Bind ViewModel.FilePath, Mode=OneWay}" 
                                           Style="{ThemeResource CaptionTextBlockStyle}"
                                           Opacity="0.7"
                                           MaxWidth="500"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Opacity="0.5"
                                           Visibility="{x:Bind ViewModel.HasFileInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Run Text="{x:Bind ViewModel. FileSizeText, Mode=OneWay}"/>
                                    <Run Text="  •  "/>
                                    <Run Text="{x:Bind ViewModel.FileModifiedText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.OpenFileCommand}"
                            ToolTipService.ToolTip="Open file (Ctrl+O)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                            <TextBlock Text="Open"/>
                        </StackPanel>
                    </Button>

                    <AppBarSeparator/>

                    <ToggleButton IsChecked="{x:Bind ViewModel.IsWordWrapEnabled, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Toggle word wrap"
                                  Visibility="{x:Bind ViewModel.IsTextVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE8B8;" FontSize="16"/>
                    </ToggleButton>

                    <Button Command="{x:Bind ViewModel.CopyContentCommand}"
                            ToolTipService.ToolTip="Copy content to clipboard">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                            <TextBlock Text="Copy"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{x:Bind ViewModel.SaveContentCommand}" 
                            Style="{ThemeResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Save changes (Ctrl+S)"
                            Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search and Navigation Toolbar (Always Visible) -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,10"
                Visibility="{x:Bind ViewModel.IsTextVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Find -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE721;" FontSize="14" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBox x:Name="FindTextBox"
                             PlaceholderText="Find in file...  (Ctrl+F)"
                             Width="250"
                             TextChanged="FindTextBox_TextChanged"
                             KeyDown="FindTextBox_KeyDown"/>
                    <Button Click="FindPrevious_Click" 
                            ToolTipService.ToolTip="Previous match"
                            Padding="8,6">
                        <FontIcon Glyph="&#xE74A;" FontSize="12"/>
                    </Button>
                    <Button Click="FindNext_Click" 
                            ToolTipService.ToolTip="Next match (Enter)"
                            Padding="8,6">
                        <FontIcon Glyph="&#xE74B;" FontSize="12"/>
                    </Button>
                    <TextBlock x:Name="FindResultsText"
                               VerticalAlignment="Center"
                               Opacity="0.6"
                               FontSize="12"
                               MinWidth="80"/>
                </StackPanel>

                <!-- Center: Stats (Prominent) -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Spacing="24"
                            VerticalAlignment="Center">
                    <!-- Line Count - Prominent -->
                    <Border Background="{StaticResource PreviewAccentColor}"
                            CornerRadius="6"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8FD;" FontSize="14" Foreground="White"/>
                            <TextBlock Foreground="White" FontWeight="SemiBold">
                                <Run Text="{x:Bind ViewModel. LineCount, Mode=OneWay}"/>
                                <Run Text="Lines"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Character Count -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8C1;" FontSize="14" Opacity="0.7"/>
                            <TextBlock Opacity="0.8">
                                <Run Text="{x:Bind ViewModel.CharacterCount, Mode=OneWay}"/>
                                <Run Text="Chars"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Cursor Position -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8A1;" FontSize="14" Opacity="0.7"/>
                            <TextBlock Opacity="0.8">
                                <Run Text="Ln"/>
                                <Run Text="{x:Bind ViewModel.CurrentLine, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text=", Col"/>
                                <Run Text="{x:Bind ViewModel.CurrentColumn, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Selection Count (when active) -->
                    <Border Background="#107C10"
                            CornerRadius="6"
                            Padding="12,6"
                            Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8B3;" FontSize="14" Foreground="White"/>
                            <TextBlock Foreground="White" FontWeight="SemiBold">
                                <Run Text="{x:Bind ViewModel.SelectionLength, Mode=OneWay}"/>
                                <Run Text="Selected"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Go to Line -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8A1;" FontSize="14" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock Text="Go to line:" VerticalAlignment="Center" Opacity="0.7"/>
                    <NumberBox x:Name="GoToLineNumberBox"
                               Minimum="1"
                               Maximum="{x:Bind ViewModel. LineCount, Mode=OneWay}"
                               SpinButtonPlacementMode="Compact"
                               Width="120"
                               KeyDown="GoToLineNumberBox_KeyDown"
                               PlaceholderText="Line #"/>
                    <Button Click="GoToLineButton_Go_Click" 
                            ToolTipService.ToolTip="Go to line (Enter)"
                            Padding="8,6">
                        <FontIcon Glyph="&#xE72A;" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="2" Margin="24,16,24,0">
            <!-- Loading -->
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock Text="Loading file..." Opacity="0.7"/>
            </StackPanel>

            <!-- Error State -->
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="#C42B1C"/>
                <TextBlock Text="Unable to load file" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{x:Bind ViewModel. ErrorMessage, Mode=OneWay}" 
                           Opacity="0.7" 
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Content="Go Back" Click="GoBackButton_Click"/>
                    <Button Content="Open Different File" Command="{x:Bind ViewModel.OpenFileCommand}"/>
                </StackPanel>
            </StackPanel>

            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Spacing="16"
                        Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xE8A5;" FontSize="64" Opacity="0.3"/>
                <TextBlock Text="No file loaded" FontSize="18" FontWeight="SemiBold" Opacity="0.6" HorizontalAlignment="Center"/>
                <TextBlock Text="Open a file to preview or edit its contents" FontSize="13" Opacity="0.4" HorizontalAlignment="Center"/>
                <Button Command="{x:Bind ViewModel.OpenFileCommand}" 
                        Style="{ThemeResource AccentButtonStyle}"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                        <TextBlock Text="Open File"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- CSV DataGrid -->
            <controls:DataGrid Visibility="{x:Bind ViewModel.IsCsvVisible, Mode=OneWay}" 
                               ItemsSource="{x:Bind ViewModel.CsvData. DefaultView, Mode=OneWay}" 
                               AutoGenerateColumns="True" 
                               IsReadOnly="True"
                               CornerRadius="4"
                               BorderBrush="{ThemeResource ControlStrokeColorDefault}"
                               BorderThickness="1"/>

            <!-- Text Editor -->
            <TextBox x:Name="ContentTextBox"
                     Visibility="{x:Bind ViewModel.IsTextVisible, Mode=OneWay}"
                     BorderBrush="{ThemeResource ControlStrokeColorDefault}" 
                     BorderThickness="1"
                     CornerRadius="4"
                     Text="{x:Bind ViewModel.TextContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="{x:Bind ViewModel. IsWordWrapEnabled, Mode=OneWay, Converter={StaticResource BoolToTextWrappingConverter}}"
                     AcceptsReturn="True" 
                     FontFamily="Cascadia Code, Consolas, Courier New" 
                     FontSize="13"
                     Padding="12"
                     IsReadOnly="{x:Bind ViewModel. IsReadOnly, Mode=OneWay}"
                     SelectionChanged="ContentTextBox_SelectionChanged"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Grid>

        <!-- Status Bar (simplified - main stats now in toolbar) -->
        <Border Grid.Row="3"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="24,6"
                Visibility="{x:Bind ViewModel.IsTextVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left - Encoding info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16">
                    <TextBlock FontSize="12" Opacity="0.5" VerticalAlignment="Center">
                        <Run Text="UTF-8"/>
                    </TextBlock>
                    <TextBlock FontSize="12" Opacity="0.5" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.IsWordWrapEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Run Text="Word Wrap: On"/>
                    </TextBlock>
                </StackPanel>

                <!-- Right - Keyboard shortcuts hint -->
                <TextBlock Grid.Column="1" 
                           FontSize="11" 
                           Opacity="0.4"
                           VerticalAlignment="Center">
                    <Run Text="Ctrl+S Save"/>
                    <Run Text="  |  "/>
                    <Run Text="Ctrl+F Find"/>
                    <Run Text="  |  "/>
                    <Run Text="Ctrl+G Go to Line"/>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Page>