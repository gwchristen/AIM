<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AIM.Views.LogViewerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:AIM.Models"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer>
            <StackPanel Margin="24" Spacing="16">
                <TextBlock Text="📋 Log Viewer" Style="{ThemeResource TitleTextBlockStyle}"/>

                <InfoBar
                    IsOpen="True"
                    Severity="Informational"
                    Title="Basic Logging"
                    Message="Application logs are displayed here."
                    IsClosable="False"/>

                <!-- Logs List -->
                <ListView ItemsSource="{Binding AuditLogs}" 
                         SelectionMode="None"
                         IsItemClickEnabled="False">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:LogEntry">
                            <StackPanel Spacing="4" Padding="8">
                                <TextBlock FontSize="12" Foreground="#999999">
                                    <Run Text="{x:Bind Timestamp, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock FontWeight="SemiBold">
                                    <Run Text="{x:Bind UserName, Mode=OneWay}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{x:Bind Action, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock 
                                    Text="{x:Bind Details, Mode=OneWay}" 
                                    FontSize="12"
                                    TextWrapping="Wrap"
                                    Foreground="#666666"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
