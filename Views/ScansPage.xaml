<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AIM.Views.ScansPage">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Directory List -->
        <ListBox Grid.Column="0" ItemsSource="{Binding Directories}" SelectedItem="{Binding SelectedDirectory}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Files List -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Sort Headers -->
            <Grid Grid.Row="0" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding SortCommand}" CommandParameter="Name" Padding="0" HorizontalAlignment="Stretch" FontWeight="Bold" Content="Name"/>
                <Button Grid.Column="1" Command="{Binding SortCommand}" CommandParameter="Size" Padding="0" HorizontalAlignment="Stretch" FontWeight="Bold" Content="Size"/>
                <Button Grid.Column="2" Command="{Binding SortCommand}" CommandParameter="Created" Padding="0" HorizontalAlignment="Stretch" FontWeight="Bold" Content="Created"/>
                <Button Grid.Column="3" Command="{Binding SortCommand}" CommandParameter="Modified" Padding="0" HorizontalAlignment="Stretch" FontWeight="Bold" Content="Modified"/>
            </Grid>

            <!-- Files List -->
            <ListBox Grid.Row="1" Name="FilesListView" ItemsSource="{Binding Files}" SelectionMode="Multiple" Margin="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Grid.Column="0" />
                            <TextBlock Text="{Binding SizeString}" Grid.Column="1" />
                            <TextBlock Text="{Binding CreatedDateString}" Grid.Column="2" />
                            <TextBlock Text="{Binding ModifiedDateString}" Grid.Column="3" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
