<UserControl
    x:Class="AIM.Views.AdminTools.BatchRenamerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:AIM.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <SolidColorBrush x:Key="RenamerAccentColor" Color="#0078D4"/>
        <SolidColorBrush x:Key="WarningColor" Color="#D83B01"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#107C10"/>
        <SolidColorBrush x:Key="OldNameColor" Color="#C42B1C"/>
        <SolidColorBrush x:Key="NewNameColor" Color="#107C10"/>
        <SolidColorBrush x:Key="ArrowColor" Color="#0078D4"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="400"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*" MinWidth="350"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Configuration -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" Padding="0,0,12,24">

                    <!-- Header Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{StaticResource RenamerAccentColor}"
                        BorderThickness="0,0,0,3"
                        CornerRadius="8"
                        Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" 
                                Background="{StaticResource RenamerAccentColor}" 
                                CornerRadius="8" 
                                Width="48" Height="48"
                                Margin="0,0,16,0">
                                <FontIcon Glyph="&#xE8AC;" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Batch Renamer" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                                <TextBlock Text="Sequentially rename files with a custom naming pattern.  Preview changes before applying." 
                                       TextWrapping="Wrap" 
                                       Opacity="0.7"
                                       Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Warning Banner -->
                    <Border Background="#FFF4CE"
                        BorderBrush="{StaticResource WarningColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" 
                                  Glyph="&#xE7BA;" 
                                  FontSize="24" 
                                  Foreground="{StaticResource WarningColor}"
                                  Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Warning: Destructive Operation" 
                                       FontWeight="SemiBold" 
                                       Foreground="{StaticResource WarningColor}"/>
                                    <TextBlock Text="This action will permanently rename files.  Review the preview carefully before proceeding."
                                       Foreground="#696969"
                                       TextWrapping="Wrap" 
                                       Opacity="0.8"
                                       Margin="0,4,0,0"/>
                                </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Step 1: Select Directory -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{StaticResource RenamerAccentColor}" 
                                    CornerRadius="14" 
                                    Width="28" Height="28">
                                    <TextBlock Text="1" FontWeight="Bold" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Select Directory" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="Choose the parent directory containing files to rename" Opacity="0.6" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Margin="40,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" 
                                     Text="{Binding RenameDirectory, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     PlaceholderText="No directory selected..."
                                     Margin="0,0,8,0"/>
                                <Button Grid.Column="1" 
                                    Command="{Binding SelectRenameDirectoryCommand}"
                                    IsEnabled="{Binding IsRenaming, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8DA;" FontSize="14"/>
                                        <TextBlock Text="Browse"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Directory Stats -->
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Padding="12"
                                Margin="40,0,0,0"
                                Visibility="{Binding HasDirectoryPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="Files Found" FontSize="12" Opacity="0.6"/>
                                            <TextBlock Text="{Binding TotalFileCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <TextBlock Text="Folders" FontSize="12" Opacity="0.6"/>
                                            <TextBlock Text="{Binding SubfolderCount, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                                        </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Step 2: Naming Pattern -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{Binding Step2Color, Mode=OneWay}" 
                                    CornerRadius="14" 
                                    Width="28" Height="28">
                                    <TextBlock Text="2" FontWeight="Bold" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Naming Pattern" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="Configure how files will be renamed" Opacity="0.6" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Spacing="16" Margin="40,0,0,0">
                                <!-- Base Name Input -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Base Filename" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBox Text="{Binding BaseFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         PlaceholderText="Enter base name (e.g., Device, Item, File)"
                                         IsEnabled="{Binding IsRenaming, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    <TextBlock Text="Leave empty for numbers only (1. txt, 2.txt, etc. )" 
                                           FontSize="11" Opacity="0.5"/>
                                </StackPanel>

                                <!-- Start Number -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Start Number" FontWeight="SemiBold" FontSize="13"/>
                                    <NumberBox Value="{Binding StartNumber, Mode=TwoWay}" 
                                           Minimum="0"
                                           SpinButtonPlacementMode="Compact"
                                           SmallChange="1"
                                           LargeChange="10"
                                           IsEnabled="{Binding IsRenaming, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                           Width="150"
                                           HorizontalAlignment="Left"/>
                                </StackPanel>

                                <!-- Padding Options -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Number Padding" FontWeight="SemiBold" FontSize="13"/>
                                    <ComboBox SelectedIndex="{Binding PaddingIndex, Mode=TwoWay}" 
                                          Width="200"
                                          IsEnabled="{Binding IsRenaming, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <ComboBoxItem Content="No padding (1, 2, 3...)"/>
                                        <ComboBoxItem Content="2 digits (01, 02, 03...)"/>
                                        <ComboBoxItem Content="3 digits (001, 002, 003...)"/>
                                        <ComboBoxItem Content="4 digits (0001, 0002, 0003...)"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Step 3: Apply -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Background="{Binding Step3Color, Mode=OneWay}" 
                                    CornerRadius="14" 
                                    Width="28" Height="28">
                                    <TextBlock Text="3" FontWeight="Bold" Foreground="White" 
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Apply Changes" FontWeight="SemiBold" FontSize="15"/>
                                    <TextBlock Text="Review the preview, then apply the rename" Opacity="0.6" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Margin="40,0,0,0" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button Command="{Binding RenameFilesCommand}" 
                                        Style="{ThemeResource AccentButtonStyle}"
                                        IsEnabled="{Binding CanRename, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8AC;" FontSize="14"/>
                                            <TextBlock Text="Apply Rename"/>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Orientation="Horizontal" 
                                            Spacing="8"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsRenaming, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ProgressRing IsActive="True" Width="20" Height="20"/>
                                        <TextBlock Text="{Binding RenameProgressText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Not Ready Message -->
                                <StackPanel Orientation="Horizontal" 
                                        Spacing="8"
                                        Visibility="{Binding CanRename, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <FontIcon Glyph="&#xE946;" FontSize="12" Opacity="0.5"/>
                                    <TextBlock Text="Select a directory with files to enable renaming" 
                                           FontSize="12" Opacity="0.5"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Success Results -->
                    <Border Background="#DFF6DD"
                        BorderBrush="{StaticResource SuccessColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Visibility="{Binding ShowResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <FontIcon Grid.Column="0" 
                                  Glyph="&#xE73E;" 
                                  FontSize="24" 
                                  Foreground="{StaticResource SuccessColor}"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"/>

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="Rename Complete!" 
                                       FontWeight="SemiBold" 
                                       FontSize="14"
                                       Foreground="{StaticResource SuccessColor}"/>
            <TextBlock Text="{Binding ResultSummaryText, Mode=OneWay}" 
                                       FontSize="12"
                                       Opacity="0.8"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Command="{Binding OpenDirectoryCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8DA;" FontSize="14"/>
                    <TextBlock Text="Open Folder"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ClearResultsCommand}" ToolTipService.ToolTip="Clear">
                <FontIcon Glyph="&#xE711;" FontSize="12"/>
            </Button>
        </StackPanel>
    </Grid>
    </Border>

    </StackPanel>
    </ScrollViewer>

    <!-- Divider -->
    <Border Grid.Column="1" 
                Width="1" 
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Margin="12,0"/>

    <!-- Right Column: Live Preview -->
    <Border Grid.Column="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Margin="12,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Preview Header -->
                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="8,8,0,0"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8FF;" FontSize="16" Foreground="{StaticResource RenamerAccentColor}"/>
                                <TextBlock Text="Rename Preview" FontWeight="SemiBold" FontSize="14"/>
                                <Border Background="{StaticResource RenamerAccentColor}"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Visibility="{Binding HasPreviewItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding PreviewItemCount, Mode=OneWay}" FontSize="11" Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <Button Grid.Column="1" 
                                Command="{Binding RefreshPreviewCommand}"
                                ToolTipService.ToolTip="Refresh preview"
                                Padding="8,4"
                                Visibility="{Binding HasDirectoryPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                            </Button>
                    </Grid>
                </Border>

                <!-- Preview Content -->
                <Grid Grid.Row="1">
                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center" 
                                VerticalAlignment="Center" 
                                Spacing="12"
                                Visibility="{Binding HasPreviewItems, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE8A5;" FontSize="48" Opacity="0.2"/>
                        <TextBlock Text="No preview available" FontSize="14" Opacity="0.5" HorizontalAlignment="Center"/>
                        <TextBlock Text="Select a directory to see rename preview" FontSize="12" Opacity="0.4" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Preview List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasPreviewItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsRepeater ItemsSource="{Binding PreviewItems}" Margin="12">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Vertical" Spacing="2"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" 
                                          Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                          CornerRadius="4"
                                          Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                            <!-- Old Name -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="12" Opacity="0.5"/>
                                                <TextBlock Text="{Binding OldName}" 
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource OldNameColor}"
                                                       ToolTipService.ToolTip="{Binding OldName}"/>
                                            </StackPanel>

                                            <!-- Arrow -->
                                            <FontIcon Grid.Column="1" 
                                                  Glyph="&#xE72A;" 
                                                  FontSize="12" 
                                                  Foreground="{StaticResource ArrowColor}"
                                                  Margin="8,0"/>

                                            <!-- New Name -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8A5;" FontSize="12" Foreground="{StaticResource NewNameColor}"/>
                                                <TextBlock Text="{Binding NewName}" 
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource NewNameColor}"
                                                       ToolTipService.ToolTip="{Binding NewName}"/>
                                            </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>