<UserControl
    x:Class="AIM.Views.AdminTools.BatchRenamerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:AIM.Converters"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>

        <SolidColorBrush x:Key="RenamerAccentColor" Color="#0078D4"/>
        <SolidColorBrush x:Key="WarningColor" Color="#D83B01"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="0,0,0,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Card -->
            <Border Grid.Row="0" 
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{StaticResource RenamerAccentColor}"
                    BorderThickness="0,0,0,3"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            Background="{StaticResource RenamerAccentColor}" 
                            CornerRadius="8" 
                            Width="48" Height="48"
                            Margin="0,0,16,0">
                        <FontIcon Glyph="&#xE8AC;" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Batch Renamer" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                        <TextBlock Text="Sequentially rename all files within each OpCo subfolder of a selected parent directory.  Files will be renamed to 1. txt, 2. txt, etc." 
                                   TextWrapping="Wrap" 
                                   Opacity="0.7"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Warning Banner -->
            <Border Grid.Row="1"
                    Background="#FFF4CE"
                    BorderBrush="{StaticResource WarningColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0" 
                              Glyph="&#xE7BA;" 
                              FontSize="24" 
                              Foreground="{StaticResource WarningColor}"
                              Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Warning: Destructive Operation" 
                                   FontWeight="SemiBold" 
                                   Foreground="{StaticResource WarningColor}"/>
                        <TextBlock Text="This action will permanently rename files and cannot be undone.  Make sure you have a backup before proceeding."
                                   Foreground="#696969"
                                   TextWrapping="Wrap" 
                                   Opacity="0.8"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Action Card -->
            <Border Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,0,16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Select Parent Directory" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="Choose the parent directory containing OpCo subfolders.  Each subfolder's files will be renamed sequentially." 
                               Opacity="0.7" 
                               TextWrapping="Wrap"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" 
                                 Text="{Binding RenameDirectory, Mode=OneWay}" 
                                 IsReadOnly="True" 
                                 PlaceholderText="No directory selected..."
                                 Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Command="{Binding SelectRenameDirectoryCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="14"/>
                                    <TextBlock Text="Browse"/>
                                </StackPanel>
                            </Button>
                    </Grid>

                    <!-- Directory Preview -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Padding="16"
                            Visibility="{Binding HasDirectoryPreview, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Subfolders to process:" FontWeight="SemiBold"/>

                            <ItemsRepeater ItemsSource="{Binding PreviewSubfolders}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="8"/>
                                    </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="14" Foreground="{StaticResource RenamerAccentColor}" Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding RelativePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding FileCountText}" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>

                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                            <TextBlock Opacity="0.7">
                                <Run Text="Total:"/>
                                <Run Text="{Binding TotalFileCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="files in"/>
                                <Run Text="{Binding SubfolderCount, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="subfolders"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Action Button -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{Binding RenameFilesCommand}" 
                                Style="{ThemeResource AccentButtonStyle}"
                                IsEnabled="{Binding CanRename, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8AC;" FontSize="14"/>
                                <TextBlock Text="Begin Batch Rename"/>
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" 
                                    Spacing="8"
                                    Visibility="{Binding IsRenaming, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ProgressRing IsActive="True" Width="20" Height="20"/>
                            <TextBlock Text="{Binding RenameProgressText, Mode=OneWay}" VerticalAlignment="Center" Opacity="0.8"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Results Card -->
            <Border Grid.Row="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{StaticResource RenamerAccentColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Visibility="{Binding ShowResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="16">
                    <!-- Success Header -->
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Background="#DFF6DD" CornerRadius="20" Width="40" Height="40">
                            <FontIcon Glyph="&#xE73E;" FontSize="20" Foreground="#107C10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Batch Rename Complete!" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="{Binding ResultSummaryText, Mode=OneWay}" FontSize="13" Opacity="0.7"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Results Details -->
                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Results by Subfolder:" FontWeight="SemiBold" Margin="0,0,0,8"/>

                            <ItemsRepeater ItemsSource="{Binding RenameResults}">
                                <ItemsRepeater.Layout>
                                    <StackLayout Orientation="Vertical" Spacing="6"/>
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                    <!-- In the Results ItemsRepeater. ItemTemplate -->
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <FontIcon Grid.Column="0" 
                                                          Glyph="&#xE73E;" 
                                                          FontSize="12" 
                                                          Foreground="#107C10" 
                                                          Margin="0,0,8,0"
                                                          VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding FolderName}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FilesRenamed}" FontWeight="SemiBold" FontSize="12"/>
                                                    <TextBlock Text="files" FontSize="12" Opacity="0.7"/>
                                                    <TextBlock Text="(" FontSize="12" Opacity="0.5"/>
                                                    <TextBlock Text="{Binding RangeText}" FontSize="12" Opacity="0.7"/>
                                                    <TextBlock Text=")" FontSize="12" Opacity="0.5"/>
                                                </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding OpenDirectoryCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8DA;" FontSize="14"/>
                                <TextBlock Text="Open in Explorer"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearResultsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE894;" FontSize="14"/>
                                <TextBlock Text="Clear Results"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>