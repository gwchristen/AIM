<Page
    x:Class="AIM.Views.PrintableFormPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:AIM.Models"
    xmlns:converters="using:AIM.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- The DataTemplate definitions are correct. -->
        <DataTemplate x:Key="Level2HeaderTemplate" x:DataType="models:PrintableFormItem">
            <Grid Background="#FFF3CD" BorderBrush="Black" BorderThickness="1,1,1,0">
                <TextBlock Text="{x:Bind Content}" FontWeight="Bold" Margin="4" VerticalAlignment="Center" Foreground="Black"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Level3aTemplate" x:DataType="models:PrintableFormItem">
            <Grid BorderBrush="Black" BorderThickness="1,1,1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0" Width="50"/>
                <Grid Grid.Column="1" Background="#D4EDDA">
                    <TextBlock Text="{x:Bind Content}" FontWeight="SemiBold" Margin="4" VerticalAlignment="Center" Foreground="Black"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Level3bTemplate" x:DataType="models:PrintableFormItem">
            <Grid BorderBrush="Black" BorderThickness="1,1,1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0" Width="50"/>
                <Grid Grid.Column="1" Background="#CCE5FF">
                    <TextBlock Text="{x:Bind Content}" FontWeight="SemiBold" Margin="4" VerticalAlignment="Center" Foreground="Black"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="Level3cTemplate" x:DataType="models:PrintableFormItem">
            <Grid BorderBrush="Black" BorderThickness="1,1,1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0" Width="50"/>
                <Grid Grid.Column="1" Background="#F8D7DA">
                    <TextBlock Text="{x:Bind Content}" FontWeight="SemiBold" Margin="4" VerticalAlignment="Center" Foreground="Black"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FileTemplate" x:DataType="models:PrintableFormItem">
            <Grid BorderBrush="Black" BorderThickness="1,0,1,0" MinHeight="28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="2" Text="{x:Bind Content}" Margin="4" VerticalAlignment="Center" Foreground="Black"/>
                <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0,0,1,0"/>
                <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0,0,1,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BlankTemplate">
            <Grid MinHeight="28" BorderBrush="Black" BorderThickness="1,0,1,1"/>
        </DataTemplate>

        <!-- THE FIX: The property names here MUST exactly match the C# properties. -->
        <converters:FormRowTemplateSelector x:Key="RowTemplateSelector"
            Level2HeaderTemplate="{StaticResource Level2HeaderTemplate}"
            Level3Header_A_Template="{StaticResource Level3aTemplate}"
            Level3Header_B_Template="{StaticResource Level3bTemplate}"
            Level3Header_C_Template="{StaticResource Level3cTemplate}"
            FileTemplate="{StaticResource FileTemplate}"
            BlankTemplate="{StaticResource BlankTemplate}"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="Back" Label="Back" Command="{Binding ViewModel.GoBackCommand}"/>
            <AppBarSeparator/>
            <AppBarButton Icon="Print" Label="Print" Command="{Binding ViewModel.PrintCommand}" CommandParameter="{Binding ElementName=PrintableArea}"/>
        </CommandBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid x:Name="PrintableArea" Margin="24" Background="White" Visibility="{x:Bind ViewModel.FormData, Converter={StaticResource NullToVisibilityConverter}, Mode=OneWay}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.FormData.Header, Mode=OneWay}" Style="{ThemeResource HeaderTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Black"/>
                        <TextBlock Grid.Column="1" Text="Initials: ________" Style="{ThemeResource BodyTextBlockStyle}" VerticalAlignment="Center" Foreground="Black"/>
                    </Grid>

                    <ListView ItemsSource="{x:Bind ViewModel.FormData.Items, Mode=OneWay}"
                              ItemTemplateSelector="{StaticResource RowTemplateSelector}"
                              SelectionMode="None"
                              BorderBrush="Black"
                              BorderThickness="1"
                              Margin="0,20,0,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>