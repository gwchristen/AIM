<Page
    x:Class="AIM.Views.InventoryAdminToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:admintools="using:AIM.Views.AdminTools"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="24">
        <TabView>
            <TabView.TabItems>
                <!-- Dir Archiver - Orange Icon -->
                <TabViewItem Header="Dir Archiver">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE7B8;" FontWeight="Bold" Foreground="#EA6100"/>
                    </TabViewItem.IconSource>
                    <admintools:DirArchiverView/>
                </TabViewItem>

                <!-- Dir Cloner - Green Icon -->
                <TabViewItem Header="Dir Cloner">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE8C8;" FontWeight="Bold" Foreground="#107C10"/>
                    </TabViewItem.IconSource>
                    <admintools:DirClonerView/>
                </TabViewItem>

                <!-- Batch Renamer - Blue Icon -->
                <TabViewItem Header="Batch Renamer">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE8AC;" FontWeight="Bold" Foreground="#0078D4"/>
                        </TabViewItem.IconSource>
                        <admintools:BatchRenamerView/>
                </TabViewItem>
                </TabView.TabItems>
        </TabView>
    </Grid>
</Page>