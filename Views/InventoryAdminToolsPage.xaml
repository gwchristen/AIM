<Page
    x:Class="AIM.Views.InventoryAdminToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:admintools="using:AIM.Views.AdminTools"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="24">
        <Grid.Resources>
            <!-- Enhanced style with better visuals -->
            <Style x:Key="ColoredTabViewItemStyle" TargetType="TabViewItem">
                <Setter Property="Padding" Value="16,8"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </Grid.Resources>

        <TabView TabStripHeader="Admin Tools">
            <TabView.TabItems>
                <!-- Dir Archiver Tab - Archive Icon -->
                <TabViewItem Header="📦 Dir Archiver" Style="{StaticResource ColoredTabViewItemStyle}">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE7B8;" Foreground="#FF6B6B"/>
                    </TabViewItem.IconSource>
                    <admintools:DirArchiverView/>
                </TabViewItem>

                <!-- Dir Cloner Tab - Copy Icon -->
                <TabViewItem Header="📋 Dir Cloner" Style="{StaticResource ColoredTabViewItemStyle}">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE8C8;" Foreground="#4ECDC4"/>
                    </TabViewItem.IconSource>
                    <admintools:DirClonerView/>
                </TabViewItem>

                <!-- Batch Renamer Tab - Edit Icon -->
                <TabViewItem Header="✏️ Batch Renamer" Style="{StaticResource ColoredTabViewItemStyle}">
                    <TabViewItem.IconSource>
                        <FontIconSource Glyph="&#xE8AC;" Foreground="#FFD93D"/>
                    </TabViewItem.IconSource>
                    <admintools:BatchRenamerView/>
                </TabViewItem>
            </TabView.TabItems>
        </TabView>
    </Grid>
</Page>