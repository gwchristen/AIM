<Page
    x:Class="AIM.Views.InventoryAdminToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:admintools="using:AIM.Views.AdminTools"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="24,16">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE90F;" FontSize="28" Foreground="#f0e68c"/>
                    <StackPanel>
                        <TextBlock Text="Admin Tools" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock Text="Directory management and batch operations" 
                               Style="{ThemeResource CaptionTextBlockStyle}" 
                               Opacity="0.7"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Tab Content -->
            <TabView Grid.Row="1" 
                 Margin="24,16,24,24"
                 IsAddTabButtonVisible="False"
                 TabWidthMode="SizeToContent"
                 CloseButtonOverlayMode="Auto">
                <TabView.Resources>
                    <Thickness x:Key="TabViewItemHeaderPadding">16,8,16,8</Thickness>
                </TabView.Resources>

                <TabView.TabItems>
                    <!-- Dir Archiver -->
                    <TabViewItem Header="Dir Archiver" IsClosable="False">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE7B8;" Foreground="#EA6100"/>
                        </TabViewItem.IconSource>
                        <admintools:DirArchiverView/>
                    </TabViewItem>

                    <!-- Dir Cloner -->
                    <TabViewItem Header="Dir Cloner" IsClosable="False">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE8C8;" Foreground="#107C10"/>
                        </TabViewItem.IconSource>
                        <admintools:DirClonerView/>
                    </TabViewItem>

                    <!-- Batch Renamer -->
                    <TabViewItem Header="Batch Renamer" IsClosable="False">
                        <TabViewItem.IconSource>
                            <FontIconSource Glyph="&#xE8AC;" Foreground="#0078D4"/>
                        </TabViewItem.IconSource>
                        <admintools:BatchRenamerView/>
                    </TabViewItem>
                    </TabView.TabItems>
            </TabView>
    </Grid>
</Page>