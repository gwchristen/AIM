<Page
    x:Class="AIM.Views.DirAnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:AIM.Converters"
    xmlns:models="using:AIM.Models"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter"/>
        <converters:ProgressColorConverter x:Key="ProgressColorConverter"/>
    </Page.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,20">
            <TextBlock Text="Directory Analysis" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Select a directory to view file count/size statistics and scan for file anomalies." TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding AnalysisDirectory, Mode=OneWay}" IsReadOnly="True" PlaceholderText="Select a directory to analyze..." MinWidth="400"/>
                <Button Content="Browse..." Command="{Binding SelectAnalysisDirectoryCommand}"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollMode="Auto">
            <StackPanel Spacing="20">

                <!-- Statistics Cards - More Compact -->
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ohio Card -->
                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Ohio" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                            <Grid RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Target:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TargetDevicesOhio, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Files:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OhioFileCount, Mode=OneWay}" FontSize="12"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Devices:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding OhioDeviceCount, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="/" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding TargetDevicesOhio, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Gap:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OhioDifference, Mode=OneWay}" FontSize="12" Foreground="OrangeRed" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Progress:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Vertical" Spacing="2">
                                    <ProgressBar Value="{Binding OhioPercentage, Mode=OneWay}" Maximum="100" Height="10" CornerRadius="3" Foreground="{Binding OhioPercentage, Mode=OneWay, Converter={StaticResource ProgressColorConverter}}"/>
                                    <TextBlock Text="{Binding OhioPercentage, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="% Diff:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding OhioPercentage, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="%" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- I&M Card -->
                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="I&amp;M" Style="{StaticResource BodyStrongTextBlockStyle}"/>

                            <Grid RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Target:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TargetDevicesIm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Files:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ImFileCount, Mode=OneWay}" FontSize="12"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Devices:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding ImDeviceCount, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="/" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    <TextBlock Text="{Binding TargetDevicesIm, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Gap:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IMDifference, Mode=OneWay}" FontSize="12" Foreground="OrangeRed" FontWeight="SemiBold"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Progress:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Vertical" Spacing="2">
                                    <ProgressBar Value="{Binding IMPercentage, Mode=OneWay}" Maximum="100" Height="10" CornerRadius="3" Foreground="{Binding IMPercentage, Mode=OneWay, Converter={StaticResource ProgressColorConverter}}"/>
                                    <TextBlock Text="{Binding IMPercentage, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="% Diff:" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding IMPercentage, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="%" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Directory Statistics -->
                <StackPanel Spacing="8" Visibility="{Binding OpCoStats, Converter={StaticResource CollectionToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock Text="Directory Statistics by OpCo" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ListView ItemsSource="{Binding OpCoStats, Mode=OneWay}" MaxHeight="150">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OpCoStatItem">
                                <Grid ColumnSpacing="12" Padding="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                        <ColumnDefinition Width="Auto" MinWidth="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind OpCoName}" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="12">
                                        <Run Text="{x:Bind FileCount, Mode=OneWay}"/>
                                        <Run Text="files" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="12">
                                        <Run Text="{x:Bind DeviceCount, Mode=OneWay}"/>
                                        <Run Text="devices" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- File Anomalies Section - 3 Columns -->
                <StackPanel Spacing="8">
                    <TextBlock Text="File Anomalies" Style="{StaticResource SubtitleTextBlockStyle}"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- I&M in Ohio Anomalies -->
                        <StackPanel Grid.Column="0" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74C;" Foreground="OrangeRed" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="I&amp;M in Ohio" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ImInOhioAnomalies.Count, Mode=OneWay}" FontSize="11" Foreground="OrangeRed" FontWeight="SemiBold"/>
                            <ListView ItemsSource="{Binding ImInOhioAnomalies, Mode=OneWay}" MinHeight="150" MaxHeight="300">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileAnomalyItem">
                                        <StackPanel Spacing="1" Padding="4">
                                            <TextBlock Text="{x:Bind FileName}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind FilePath}" FontSize="9" Foreground="Gray" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FilePath}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- OH/OP in I&M Anomalies -->
                        <StackPanel Grid.Column="1" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE74C;" Foreground="OrangeRed" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="OH/OP in I&amp;M" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding OhInImAnomalies.Count, Mode=OneWay}" FontSize="11" Foreground="OrangeRed" FontWeight="SemiBold"/>
                            <ListView ItemsSource="{Binding OhInImAnomalies, Mode=OneWay}" MinHeight="150" MaxHeight="300">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileAnomalyItem">
                                        <StackPanel Spacing="1" Padding="4">
                                            <TextBlock Text="{x:Bind FileName}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind FilePath}" FontSize="9" Foreground="Gray" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FilePath}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- Unidentified Files -->
                        <StackPanel Grid.Column="2" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE7BA;" Foreground="Gold" FontSize="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Unidentified" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding UnidentifiedAnomalies.Count, Mode=OneWay}" FontSize="11" Foreground="Gold" FontWeight="SemiBold"/>
                            <ListView ItemsSource="{Binding UnidentifiedAnomalies, Mode=OneWay}" MinHeight="150" MaxHeight="300">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:FileAnomalyItem">
                                        <StackPanel Spacing="1" Padding="4">
                                            <TextBlock Text="{x:Bind FileName}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{x:Bind FilePath}" FontSize="9" Foreground="Gray" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind FilePath}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>