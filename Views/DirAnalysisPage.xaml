<Page
    x:Class="AIM.Views.DirAnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:AIM.Converters"
    xmlns:models="using:AIM.Models"
    xmlns:sys="using:System" 
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!-- The <Page.DataContext> block has been REMOVED. It is set in the .xaml.cs file. -->

    <Page.Resources>
        <converters:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter"/>
    </Page.Resources>

    <Grid Margin="24">
        <StackPanel Spacing="12">
            <TextBlock Text="Directory Analysis" Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="Select a directory to view file count/size statistics and scan for file anomalies." TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{Binding AnalysisDirectory, Mode=OneWay}" IsReadOnly="True" PlaceholderText="Select a directory to analyze..." MinWidth="300"/>
                <Button Content="Browse..." Command="{Binding SelectAnalysisDirectoryCommand}"/>
            </StackPanel>

            <Grid Margin="0,20,0,0" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Stats -->
                <StackPanel Grid.Column="0" Spacing="10" Visibility="{Binding OpCoStats, Converter={StaticResource CollectionToVisibilityConverter}}">
                    <TextBlock Text="Directory Stats" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <ListView ItemsSource="{Binding OpCoStats}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OpCoStatItem">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind OpCoName}" FontWeight="SemiBold"/>
                                    <!-- CORRECTED x:Bind syntax -->
                                    <TextBlock Grid.Column="1" Text="{x:Bind sys:String.Format('{0} files', FileCount)}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind sys:String.Format('{0:N0} devices', DeviceCount)}" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <!-- Right Column: Anomalies -->
                <StackPanel Grid.Column="1" Spacing="10">
                    <!-- This visibility needs to be set up differently to work for multiple collections -->
                    <StackPanel.Visibility>
                        <Binding Path="MisplacedOhFiles.Count" Converter="{StaticResource CollectionToVisibilityConverter}">
                            <Binding.FallbackValue>Collapsed</Binding.FallbackValue>
                        </Binding>
                    </StackPanel.Visibility>

                    <TextBlock Text="File Anomalies" Style="{StaticResource SubtitleTextBlockStyle}"/>

                    <TextBlock Text="Misplaced 'OH' Files" Style="{StaticResource CaptionTextBlockStyle}" Visibility="{Binding MisplacedOhFiles, Converter={StaticResource CollectionToVisibilityConverter}}"/>
                    <ListView ItemsSource="{Binding MisplacedOhFiles}" MaxHeight="150"/>

                    <TextBlock Text="Misplaced 'IM' Files" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,10,0,0" Visibility="{Binding MisplacedImFiles, Converter={StaticResource CollectionToVisibilityConverter}}"/>
                    <ListView ItemsSource="{Binding MisplacedImFiles}" MaxHeight="150"/>

                    <TextBlock Text="Unidentified Files" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,10,0,0" Visibility="{Binding UnidentifiedFiles, Converter={StaticResource CollectionToVisibilityConverter}}"/>
                    <ListView ItemsSource="{Binding UnidentifiedFiles}" MaxHeight="150"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Page>