<Page
    x:Class="AIM.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AIM.Models"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core">
    <Grid Margin="24">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" Opacity="0.05">
                <GradientStop Color="#0099BC" Offset="0"/>
                <GradientStop Color="#00B7C3" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="16">
            <Border Background="{StaticResource InfoBrush}" 
                    CornerRadius="8" 
                    Padding="16,12">
                <TextBlock Text="Search" 
                           Style="{ThemeResource TitleTextBlockStyle}"
                           Foreground="White"
                           FontWeight="Bold"/>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{x:Bind ViewModel.SearchDirectory, Mode=TwoWay}" 
                         PlaceholderText="Search Directory" 
                         Width="400"
                         CornerRadius="6"
                         BorderBrush="{StaticResource InfoBrush}"
                         BorderThickness="2"/>
                <Button Command="{x:Bind ViewModel.BrowseCommand}" CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8DA;" FontSize="16" Foreground="{StaticResource InfoBrush}"/>
                        <TextBlock Text="Browse"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="SearchTextBox" 
                         Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}" 
                         Width="400" 
                         PlaceholderText="Enter search query"
                         CornerRadius="6"
                         BorderBrush="{StaticResource InfoBrush}"
                         BorderThickness="2"/>
                <Button Command="{x:Bind ViewModel.SearchCommand}" 
                        Style="{ThemeResource AccentButtonStyle}"
                        CornerRadius="8"
                        Background="{StaticResource InfoBrush}"
                        BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="16"/>
                        <TextBlock Text="Search" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ToggleSwitch Header="Search in file contents" 
                          IsOn="{x:Bind ViewModel.IsContentSearch, Mode=TwoWay}"/>

            <!-- THIS IS THE FIX: The old TextBlock for status messages has been completely removed. -->

        </StackPanel>

        <ListView Grid.Row="2"
                  Margin="0,16,0,0"
                  x:Name="ResultsListView"
                  ItemsSource="{x:Bind ViewModel.SearchResults}"
                  IsItemClickEnabled="True">

            <interactivity:Interaction.Behaviors>
                <core:EventTriggerBehavior EventName="DoubleTapped">
                    <core:InvokeCommandAction 
                        Command="{x:Bind ViewModel.HandleItemDoubleClickCommand}"
                        CommandParameter="{x:Bind ResultsListView.SelectedItem, Mode=OneWay}"/>
                </core:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FileItem">
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind FullPath}" TextTrimming="CharacterEllipsis" Margin="8,0"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Type}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>