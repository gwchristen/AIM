<Page
    x:Class="AIM.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AIM.Models"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="16">
            <TextBlock Text="Search" Style="{ThemeResource TitleTextBlockStyle}"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Text="{x:Bind ViewModel.SearchDirectory, Mode=TwoWay}" PlaceholderText="Search Directory" Width="400"/>
                <Button Command="{x:Bind ViewModel.BrowseCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8DA;" FontSize="16"/>
                        <TextBlock Text="Browse"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="SearchTextBox" Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}" Width="400" PlaceholderText="Enter search query"/>
                <Button Command="{x:Bind ViewModel.SearchCommand}" Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" FontSize="16"/>
                        <TextBlock Text="Search"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <ToggleSwitch Header="Search in file contents" IsOn="{x:Bind ViewModel.IsContentSearch, Mode=TwoWay}"/>

        </StackPanel>

        <ListView Grid.Row="2"
                  Margin="0,16,0,0"
                  x:Name="ResultsListView"
                  ItemsSource="{x:Bind ViewModel.SearchResults}"
                  IsItemClickEnabled="True">

            <interactivity:Interaction.Behaviors>
                <core:EventTriggerBehavior EventName="DoubleTapped">
                    <core:InvokeCommandAction 
                        Command="{x:Bind ViewModel.HandleItemDoubleClickCommand}"
                        CommandParameter="{x:Bind ResultsListView. SelectedItem, Mode=OneWay}"/>
                </core:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>

            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FileItem">
                    <Grid Margin="0,8" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- File Name -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- File Path -->
                        <TextBlock Grid.Column="1" Text="{x:Bind FullPath}" TextTrimming="CharacterEllipsis" Margin="8,0" VerticalAlignment="Center" Foreground="#666666"/>

                        <!-- File Type -->
                        <TextBlock Grid.Column="2" Text="{x:Bind Type}" VerticalAlignment="Center" TextAlignment="Center"/>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <!-- Preview Button -->
                            <Button
                                ToolTipService.ToolTip="Preview file"
                                Click="PreviewButton_Click"
                                Padding="8,4"
                                FontSize="12">
                                <FontIcon Glyph="&#xE8FF;" FontSize="14"/>
                            </Button>

                            <!-- Open in Browse Tab Button -->
                            <Button
                                ToolTipService.ToolTip="Open in Browse tab"
                                Click="BrowseButton_Click"
                                Padding="8,4"
                                FontSize="12">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14"/>
                            </Button>

                            <!-- Copy Path Button -->
                            <Button
                                ToolTipService.ToolTip="Copy file path"
                                Click="CopyPathButton_Click"
                                Padding="8,4"
                                FontSize="12">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>