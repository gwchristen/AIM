<Page
    x:Class="AIM.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">
    <Grid Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side -->
        <Grid Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                    <TextBox Header="Root" Text="{x:Bind ViewModel.RootName, Mode=OneWay}" IsReadOnly="True" Width="120"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox Header="Level 1" ItemsSource="{x:Bind ViewModel.LeftLevel1}" SelectedItem="{x:Bind ViewModel.SelectedLeftLevel1, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="LeftLevel1_SelectionChanged" Width="120"/>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Click="ClearLeftLevel1_Click" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox Header="Level 2" ItemsSource="{x:Bind ViewModel.LeftLevel2}" SelectedItem="{x:Bind ViewModel.SelectedLeftLevel2, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="LeftLevel2_SelectionChanged" Width="120"/>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Click="ClearLeftLevel2_Click" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox Header="Level 3" ItemsSource="{x:Bind ViewModel.LeftLevel3}" SelectedItem="{x:Bind ViewModel.SelectedLeftLevel3, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="LeftLevel3_SelectionChanged" Width="120"/>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Click="ClearLeftLevel3_Click" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <controls:DataGrid Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}" AutoGenerateColumns="False" CanUserSortColumns="True" SelectionChanged="FilesDataGrid_SelectionChanged" DoubleTapped="FilesDataGrid_DoubleTapped" BorderBrush="Gray" BorderThickness="1" IsReadOnly="True">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Filename" Binding="{Binding Name}" Width="*"/>
                    <controls:DataGridTextColumn Header="Size" Binding="{Binding SizeString}" Width="100"/>
                    <controls:DataGridTextColumn Header="Date Created" Binding="{Binding CreatedDateString}" Width="120"/>
                    <controls:DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDateString}" Width="120"/>
                    <controls:DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="150"/>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Grid>

        <!-- Middle -->
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Spacing="8" Margin="16">
            <Button Command="{x:Bind ViewModel.RenameItemCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8AC;" FontSize="16"/>
                    <TextBlock Text="Rename"/>
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.DeleteToArchiveCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7B8;" FontSize="16"/>
                    <TextBlock Text="Archive"/>
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.ShipItemsCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E1;" FontSize="16"/>
                    <TextBlock Text="Shipped"/>
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.MoveFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8DE;" FontSize="16"/>
                    <TextBlock Text="Move →"/>
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.UndoCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7A7;" FontSize="16"/>
                    <TextBlock Text="Undo"/>
                </StackPanel>
            </Button>
            <Rectangle Height="24"/>
            <Button Command="{x:Bind ViewModel.CopyFromScansCommand}" Style="{ThemeResource AccentButtonStyle}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C8;" FontSize="16"/>
                    <TextBlock Text="Copy from Scans"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Right Side -->
        <Grid Grid.Column="2" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                    <TextBox Header="Root" Text="{x:Bind ViewModel.RootName, Mode=OneWay}" IsReadOnly="True" Width="120"/>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox Header="Level 1" ItemsSource="{x:Bind ViewModel.RightLevel1}" SelectedItem="{x:Bind ViewModel.SelectedRightLevel1, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="RightLevel1_SelectionChanged" Width="120"/>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Click="ClearRightLevel1_Click" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox Header="Level 2" ItemsSource="{x:Bind ViewModel.RightLevel2}" SelectedItem="{x:Bind ViewModel.SelectedRightLevel2, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="RightLevel2_SelectionChanged" Width="120"/>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Click="ClearRightLevel2_Click" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ComboBox Header="Level 3" ItemsSource="{x:Bind ViewModel.RightLevel3}" SelectedItem="{x:Bind ViewModel.SelectedRightLevel3, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="RightLevel3_SelectionChanged" Width="120"/>
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" Click="ClearRightLevel3_Click" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.RightFilteredContents}" SelectedItem="{x:Bind ViewModel.SelectedRightContent, Mode=TwoWay}" SelectionChanged="RightFilteredContents_SelectionChanged" BorderBrush="Gray" BorderThickness="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="{Binding IsFolder, Converter={StaticResource BoolToSymbolConverter}}"/>
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>