<Page
    x:Class="AIM.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="5" Grid.Row="0">
            <Button Content="Rename" Command="{x:Bind ViewModel.RenameItemCommand}" Margin="0,0,5,0"/>
            <Button Content="Delete" Command="{x:Bind ViewModel.DeleteToArchiveCommand}"/>
        </StackPanel>
        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectionChanged="FilesListView_SelectionChanged" DoubleTapped="FilesListView_DoubleTapped">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>