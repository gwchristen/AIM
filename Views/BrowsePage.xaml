<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AIM.Views.BrowsePage">
    <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side -->
        <Grid Grid.Column="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Margin="5" Spacing="10">
                    <TextBox Header="Root" Text="{Binding ViewModel.RootName}" IsReadOnly="True" Width="120"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ComboBox Header="Level 1" ItemsSource="{Binding ViewModel.LeftLevel1}" SelectedItem="{Binding ViewModel.SelectedLeftLevel1}" Width="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="X" Click="ClearLeftLevel1_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ComboBox Header="Level 2" ItemsSource="{Binding ViewModel.LeftLevel2}" SelectedItem="{Binding ViewModel.SelectedLeftLevel2}" Width="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="X" Click="ClearLeftLevel2_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ComboBox Header="Level 3" ItemsSource="{Binding ViewModel.LeftLevel3}" SelectedItem="{Binding ViewModel.SelectedLeftLevel3}" Width="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="X" Click="ClearLeftLevel3_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <DataGrid Grid.Row="1" 
                      ItemsSource="{Binding ViewModel.Files}" 
                      SelectedItem="{Binding ViewModel.SelectedFile}"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      BorderBrush="Gray" 
                      BorderThickness="1" 
                      IsReadOnly="True"
                      GridLinesVisibility="All">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Filename" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeString}" Width="100"/>
                    <DataGridTextColumn Header="Date Created" Binding="{Binding CreatedDateString}" Width="120"/>
                    <DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDateString}" Width="120"/>
                    <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Middle -->
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="10" Spacing="5">
            <Button Content="Rename" Command="{Binding ViewModel.RenameItemCommand}"/>
            <Button Content="Archive" Command="{Binding ViewModel.DeleteToArchiveCommand}"/>
            <Button Content="Shipped" Command="{Binding ViewModel.ShipItemsCommand}"/>
            <Button Content="Move ->" Command="{Binding ViewModel.MoveFileCommand}"/>
            <Button Content="Undo" Command="{Binding ViewModel.UndoCommand}"/>
            <Rectangle Height="40"/>
            <Button Content="Copy from Scans" Command="{Binding ViewModel.CopyFromScansCommand}"/>
        </StackPanel>

        <!-- Right Side -->
        <Grid Grid.Column="2" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Margin="5" Spacing="10">
                    <TextBox Header="Root" Text="{Binding ViewModel.RootName}" IsReadOnly="True" Width="120"/>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ComboBox Header="Level 1" ItemsSource="{Binding ViewModel.RightLevel1}" SelectedItem="{Binding ViewModel.SelectedRightLevel1}" Width="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="X" Click="ClearRightLevel1_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ComboBox Header="Level 2" ItemsSource="{Binding ViewModel.RightLevel2}" SelectedItem="{Binding ViewModel.SelectedRightLevel2}" Width="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="X" Click="ClearRightLevel2_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <ComboBox Header="Level 3" ItemsSource="{Binding ViewModel.RightLevel3}" SelectedItem="{Binding ViewModel.SelectedRightLevel3}" Width="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="X" Click="ClearRightLevel3_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding ViewModel.RightFilteredContents}" 
                     SelectedItem="{Binding ViewModel.SelectedRightContent}"
                     Margin="5" 
                     BorderBrush="Gray" 
                     BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{Binding IsFolder, Converter={StaticResource BoolToSymbolConverter}}" 
                                      Width="16" Height="16"/>
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
