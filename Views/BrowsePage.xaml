<Page
    x:Class="AIM.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:viewmodels="using:AIM.ViewModels"
    xmlns:models="using:AIM.Models"
    xmlns:converters="using:AIM.Converters"
    d:DataContext="{d:DesignInstance Type=viewmodels:BrowseViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <SolidColorBrush x:Key="SourceAccentColor" Color="#90ee90"/>
        <SolidColorBrush x:Key="DestinationAccentColor" Color="#ffa07a"/>

        <!-- Source Column Context Menu -->
        <MenuFlyout x:Key="SourceFileContextMenu">
            <MenuFlyoutItem Text="Rename" Icon="Rename" Click="ContextMenu_Rename_Click"/>
            <MenuFlyoutItem Text="Add to Selection" Click="ContextMenu_AddToSelection_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE710;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Edit" Icon="Edit" Click="ContextMenu_Edit_Click"/>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Archive" Click="ContextMenu_Archive_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7B8;" Foreground="#EA6100"/>
                    </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Shipped" Click="ContextMenu_Shipped_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8E1;" Foreground="#107C10"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Move to Destination" Click="ContextMenu_Move_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8DE;"/>
                    </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>

        <!-- General Context Menu -->
        <MenuFlyout x:Key="GeneralContextMenu">
            <MenuFlyoutItem Text="Clear Selection" Click="ContextMenu_ClearSelection_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE894;" Foreground="#C42B1C"/>
                    </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Copy from Scans" Click="ContextMenu_CopyFromScans_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;"/>
                    </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Copy Filepath" Click="ContextMenu_CopyFilepath_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8C8;"/>
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSeparator/>
            <MenuFlyoutItem Text="Undo" Click="ContextMenu_Undo_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE7A7;"/>
                    </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid RightTapped="Page_RightTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <Grid Grid.Row="0" Margin="16,16,16,8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Side - Source Panel -->
                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Left Header -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,12">
                            <FontIcon Glyph="&#xE8B7;" FontSize="20" Foreground="{StaticResource SourceAccentColor}"/>
                            <TextBlock Text="Source" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource SourceAccentColor}"/>
                            <ProgressRing IsActive="{Binding IsLeftPanelLoading}" 
                                  Width="20" Height="20" 
                                  Visibility="{Binding IsLeftPanelLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>

                        <!-- Left Breadcrumbs -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsRepeater ItemsSource="{Binding LeftBreadcrumbs}">
                            <ItemsRepeater.Layout>
                                <StackLayout Orientation="Horizontal"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="models:BreadcrumbItem">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button DataContext="{x:Bind}" 
                                                Click="LeftBreadcrumbButton_Click" 
                                                Style="{ThemeResource TextBlockButtonStyle}" 
                                                Visibility="{x:Bind (x:Boolean)IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                            </Button>
                                        <TextBlock Text="{x:Bind Name}" 
                                                   FontWeight="SemiBold" 
                                                   Visibility="{x:Bind IsLast, Mode=OneWay}" 
                                                   VerticalAlignment="Center" 
                                                   Padding="8,4"/>
                                        <!-- Foreground="{StaticResource SourceAccentColor}"/> -->
                                            <TextBlock Text="/" 
                                                   VerticalAlignment="Center" 
                                                   FontWeight="SemiBold" 
                                                   Opacity="0.5"
                                                   Visibility="{x:Bind (x:Boolean)IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>
                    <Button Grid.Column="1" 
                            Command="{Binding GoUpLeftCommand}" 
                            HorizontalAlignment="Right"
                            ToolTipService.ToolTip="Navigate to parent folder">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74A;" FontSize="14"/>
                            <TextBlock Text="Up"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Left Content Area -->
                <Grid Grid.Row="2">
                    <!-- Left DataGrid -->
                    <controls:DataGrid
                        x:Name="LeftDataGrid"
                        ItemsSource="{Binding LeftFilteredContents}"
                        SelectionMode="Extended"
                        AutoGenerateColumns="False"
                        CanUserSortColumns="True"
                        Sorting="LeftDataGrid_Sorting"
                        SelectionChanged="LeftDataGrid_SelectionChanged"
                        DoubleTapped="LeftDataGrid_DoubleTapped"
                        PointerPressed="LeftDataGrid_PointerPressed"
                        RightTapped="LeftDataGrid_RightTapped"
                        CanDrag="True"
                        DragStarting="LeftDataGrid_DragStarting"
                        BorderBrush="{StaticResource SourceAccentColor}"
                        BorderThickness="2"
                        CornerRadius="4"
                        IsReadOnly="True"
                        Visibility="{Binding HasLeftPanelError, Converter={StaticResource InverseBoolToVisibilityConverter}}">

                        <controls:DataGrid.Columns>
                            <controls:DataGridTemplateColumn Header="Name" Tag="Name" Width="*">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:ContentItem">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,0,0,0">
                                            <SymbolIcon Symbol="{Binding SymbolIcon}"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>
                            <controls:DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDateString}" Tag="Date" Width="120"/>
                            <controls:DataGridTextColumn Header="Size" Binding="{Binding SizeString}" Tag="Size" Width="100"/>
                        </controls:DataGrid.Columns>
                    </controls:DataGrid>

                    <!-- Loading Overlay -->
                    <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            CornerRadius="4"
                            Visibility="{Binding IsLeftPanelLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressRing IsActive="True" Width="40" Height="40"/>
                            <TextBlock Text="{Binding LeftPanelLoadingText}" FontSize="14" Opacity="0.8"/>
                        </StackPanel>
                    </Border>

                    <!-- Error State -->
                    <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="#C42B1C"
                            BorderThickness="2"
                            CornerRadius="4"
                            Visibility="{Binding HasLeftPanelError, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="24">
                            <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="#C42B1C"/>
                            <TextBlock Text="Unable to load folder" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding LeftPanelErrorMessage}" 
                                       FontSize="13" Opacity="0.8" TextWrapping="Wrap"
                                       MaxWidth="300" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <Button Content="Retry" Command="{Binding RetryLeftPanelCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
        </Grid>

        <!-- Middle Column - Actions Panel -->
            <Border Grid.Column="1" 
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="8,0"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Vertical" Spacing="8">
                <TextBlock Text="Actions" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.8"/>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-8,0,-8,8"/>

                <!-- Selection Group -->
                <TextBlock Text="Selection" FontSize="11" Opacity="0.6" Margin="0,0,0,4"/>
                <Button Command="{Binding AddToSelectionCommand}" MinWidth="140" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Add selected files to persistent selection">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE710;" Foreground="#f08080" FontSize="14"/>
                        <TextBlock Text="Add to Selection"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding PreviewSelectionCommand}" MinWidth="140" HorizontalContentAlignment="Left" ToolTipService.ToolTip="View all selected files">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8FF;" Foreground="#0078D4" FontSize="14"/>
                        <TextBlock Text="Preview Selection"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ClearSelectionCommand}" MinWidth="140" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Clear all selected files">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE894;" Foreground="#C42B1C" FontSize="14"/>
                        <TextBlock Text="Clear Selection"/>
                    </StackPanel>
                </Button>

                <Rectangle Height="12"/>

                <!-- File Actions Group -->
                <TextBlock Text="File Operations" FontSize="11" Opacity="0.6" Margin="0,0,0,4"/>
                <Button Command="{Binding RenameFileCommand}" MinWidth="140" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Rename selected file">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8AC;" Foreground="#8a2be2" FontSize="14"/>
                        <TextBlock Text="Rename"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding MoveFileCommand}" MinWidth="140" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Move selected files to destination">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8DE;" Foreground="#0078D4" FontSize="14"/>
                        <TextBlock Text="Move"/>
                    </StackPanel>
                </Button>

                <Rectangle Height="12"/>

                <!-- Quick Actions Group -->
                <TextBlock Text="Quick Actions" FontSize="11" Opacity="0.6" Margin="0,0,0,4"/>
                <Button Command="{Binding ArchiveFileCommand}" MinWidth="140" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Move selected files to archive folder">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7B8;" Foreground="#EA6100" FontSize="14"/>
                        <TextBlock Text="Archive"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ShipFileCommand}" MinWidth="140" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Move selected files to shipped folder">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8E1;" Foreground="#107C10" FontSize="14"/>
                        <TextBlock Text="Shipped"/>
                    </StackPanel>
                </Button>

                <Rectangle Height="12"/>

                <!-- Undo -->
                <Button Command="{Binding UndoCommand}" MinWidth="140" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Undo last action">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7A7;" Foreground="#ffff00" FontSize="14"/>
                        <TextBlock Text="Undo"/>
                        <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="8" Padding="6,2"
                                    Visibility="{Binding UndoStackCount, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding UndoStackCount}" FontSize="10" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Rectangle Height="16"/>
                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-8,0"/>
                <Rectangle Height="16"/>

                <!-- Import Section -->
                <TextBlock Text="Import" FontSize="11" Opacity="0.6" Margin="0,0,0,4"/>
                <Button Command="{Binding CopyFromScansCommand}" Style="{StaticResource AccentButtonStyle}" MinWidth="140" HorizontalContentAlignment="Left" ToolTipService.ToolTip="Copy files from Scans tab to destination">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8C8;" FontSize="14"/>
                        <TextBlock Text="Copy from Scans"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Right Side - Destination Panel -->
        <Grid Grid.Column="2" Margin="8,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Right Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center"  Spacing="8" Margin="0,0,0,12">
                <FontIcon Glyph="&#xE8DA;" FontSize="20" Foreground="{StaticResource DestinationAccentColor}"/>
                <TextBlock Text="Destination" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource DestinationAccentColor}"/>
                <ProgressRing IsActive="{Binding IsRightPanelLoading}" 
                                  Width="20" Height="20" 
                                  Visibility="{Binding IsRightPanelLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>

            <!-- Right Breadcrumbs -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsRepeater ItemsSource="{Binding RightBreadcrumbs}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:BreadcrumbItem">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button DataContext="{x:Bind}" 
                                                Click="RightBreadcrumbButton_Click" 
                                                Style="{ThemeResource TextBlockButtonStyle}" 
                                                Visibility="{x:Bind (x:Boolean)IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                    </Button>
                                        <TextBlock Text="{x:Bind Name}" 
                                                   FontWeight="SemiBold" 
                                                   Visibility="{x:Bind IsLast, Mode=OneWay}" 
                                                   VerticalAlignment="Center" 
                                                   Padding="8,4"/>
                                        <!-- Foreground="{StaticResource DestinationAccentColor}"/> -->
                                    <TextBlock Text="/" 
                                                   VerticalAlignment="Center" 
                                                   FontWeight="SemiBold" 
                                                   Opacity="0.5"
                                                   Visibility="{x:Bind (x:Boolean)IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>
                <Button Grid.Column="1" 
                            Command="{Binding GoUpRightCommand}" 
                            HorizontalAlignment="Right"
                            ToolTipService.ToolTip="Navigate to parent folder">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74A;" FontSize="14"/>
                        <TextBlock Text="Up"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Right Content Area -->
            <Grid Grid.Row="2">
                <!-- Right ListView with drop highlight -->
                <Border x:Name="DropTargetBorder"
                            BorderThickness="3"
                            CornerRadius="4"
                            BorderBrush="Transparent">
                    <ListView x:Name="RightListView"
                                  ItemsSource="{Binding RightFilteredContents}" 
                                  SelectedItem="{Binding SelectedRightContent, Mode=TwoWay}" 
                                  BorderBrush="{StaticResource DestinationAccentColor}" 
                                  BorderThickness="2"
                                  CornerRadius="4"
                                  AllowDrop="True" 
                                  DragOver="RightListView_DragOver" 
                                  DragLeave="RightListView_DragLeave"
                                  Drop="RightListView_Drop"
                                  Visibility="{Binding HasRightPanelError, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ContentItem">
                                <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,2">
                                    <SymbolIcon Symbol="{Binding SymbolIcon}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                            </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <!-- Loading Overlay -->
                <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            CornerRadius="4"
                            Visibility="{Binding IsRightPanelLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <ProgressRing IsActive="True" Width="40" Height="40"/>
                        <TextBlock Text="{Binding RightPanelLoadingText}" FontSize="14" Opacity="0.8"/>
                    </StackPanel>
                </Border>

                <!-- Error State -->
                <Border Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                            BorderBrush="#C42B1C"
                            BorderThickness="2"
                            CornerRadius="4"
                            Visibility="{Binding HasRightPanelError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Padding="24">
                        <FontIcon Glyph="&#xE783;" FontSize="48" Foreground="#C42B1C"/>
                        <TextBlock Text="Unable to load folder" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding RightPanelErrorMessage}" 
                                       FontSize="13" Opacity="0.8" TextWrapping="Wrap"
                                       MaxWidth="300" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <Button Content="Retry" Command="{Binding RetryRightPanelCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>

    <!-- Status Bar -->
    <Border Grid.Row="1" 
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Selection Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE762;" FontSize="14" Foreground="{StaticResource SourceAccentColor}"/>
                    <TextBlock Text="{Binding SelectionStatusText}" VerticalAlignment="Center" FontSize="12"/>
                </StackPanel>

                <!-- Operation Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8"
                            Visibility="{Binding OperationStatusText, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ProgressRing IsActive="{Binding IsOperationInProgress}" Width="16" Height="16"
                                  Visibility="{Binding IsOperationInProgress, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding OperationStatusText}" VerticalAlignment="Center" FontSize="12"
                               Foreground="{ThemeResource SystemAccentColor}"/>
                </StackPanel>

                <!-- Undo Info -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                            Visibility="{Binding UndoStackCount, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE7A7;" FontSize="12" Opacity="0.6"/>
                    <TextBlock FontSize="11" Opacity="0.6">
                        <Run Text="{Binding UndoStackCount}"/>
                        <Run Text="action(s) to undo"/>
                    </TextBlock>
                </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Page>