<Page
    x:Class="AIM.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls">
    <Grid Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Side -->
        <Grid Grid.Column="0" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBox Header="Root" Text="{x:Bind ViewModel.RootName, Mode=OneWay}" IsReadOnly="True" Margin="0,0,10,0" Width="120"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <ComboBox Header="Level 1" ItemsSource="{x:Bind ViewModel.LeftLevel1}" SelectedItem="{x:Bind ViewModel.SelectedLeftLevel1, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="LeftLevel1_SelectionChanged" Width="120"/>
                        <Button Content="X" Click="ClearLeftLevel1_Click" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <ComboBox Header="Level 2" ItemsSource="{x:Bind ViewModel.LeftLevel2}" SelectedItem="{x:Bind ViewModel.SelectedLeftLevel2, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="LeftLevel2_SelectionChanged" Width="120"/>
                        <Button Content="X" Click="ClearLeftLevel2_Click" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Header="Level 3" ItemsSource="{x:Bind ViewModel.LeftLevel3}" SelectedItem="{x:Bind ViewModel.SelectedLeftLevel3, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="LeftLevel3_SelectionChanged" Width="120"/>
                        <Button Content="X" Click="ClearLeftLevel3_Click" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <controls:DataGrid Grid.Row="1" ItemsSource="{x:Bind ViewModel.Files}" SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=TwoWay}" AutoGenerateColumns="False" CanUserSortColumns="True" SelectionChanged="FilesDataGrid_SelectionChanged" DoubleTapped="FilesDataGrid_DoubleTapped" BorderBrush="Gray" BorderThickness="1" IsReadOnly="True">
                <controls:DataGrid.Columns>
                    <controls:DataGridTextColumn Header="Filename" Binding="{Binding Name}" Width="*"/>
                    <controls:DataGridTextColumn Header="Size" Binding="{Binding SizeString}" Width="100"/>
                    <controls:DataGridTextColumn Header="Date Created" Binding="{Binding CreatedDateString}" Width="120"/>
                    <controls:DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDateString}" Width="120"/>
                    <controls:DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="150"/>
                </controls:DataGrid.Columns>
            </controls:DataGrid>
        </Grid>

        <!-- Middle -->
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="10">
            <Button Content="Rename" Command="{x:Bind ViewModel.RenameItemCommand}" Margin="0,5"/>
            <Button Content="Archive" Command="{x:Bind ViewModel.DeleteToArchiveCommand}" Margin="0,5"/>
            <Button Content="Shipped" Command="{x:Bind ViewModel.ShipItemsCommand}" Margin="0,5"/>
            <Button Content="Move -&gt;" Command="{x:Bind ViewModel.MoveFileCommand}" Margin="0,5"/>
            <Button Content="Undo" Command="{x:Bind ViewModel.UndoCommand}" Margin="0,5"/>
            <Rectangle Height="40"/>
            <Button Content="Copy from Scans" Command="{x:Bind ViewModel.CopyFromScansCommand}" Margin="5"/>
        </StackPanel>

        <!-- Right Side -->
        <Grid Grid.Column="2" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBox Header="Root" Text="{x:Bind ViewModel.RootName, Mode=OneWay}" IsReadOnly="True" Margin="0,0,10,0" Width="120"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <ComboBox Header="Level 1" ItemsSource="{x:Bind ViewModel.RightLevel1}" SelectedItem="{x:Bind ViewModel.SelectedRightLevel1, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="RightLevel1_SelectionChanged" Width="120"/>
                        <Button Content="X" Click="ClearRightLevel1_Click" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                        <ComboBox Header="Level 2" ItemsSource="{x:Bind ViewModel.RightLevel2}" SelectedItem="{x:Bind ViewModel.SelectedRightLevel2, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="RightLevel2_SelectionChanged" Width="120"/>
                        <Button Content="X" Click="ClearRightLevel2_Click" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Header="Level 3" ItemsSource="{x:Bind ViewModel.RightLevel3}" SelectedItem="{x:Bind ViewModel.SelectedRightLevel3, Mode=TwoWay}" DisplayMemberPath="Name" SelectionChanged="RightLevel3_SelectionChanged" Width="120"/>
                        <Button Content="X" Click="ClearRightLevel3_Click" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.RightFilteredContents}" SelectedItem="{x:Bind ViewModel.SelectedRightContent, Mode=TwoWay}" SelectionChanged="RightFilteredContents_SelectionChanged" Margin="5" BorderBrush="Gray" BorderThickness="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <SymbolIcon Symbol="{Binding IsFolder, Converter={StaticResource BoolToSymbolConverter}}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>