<Page
    x:Class="AIM.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:viewmodels="using:AIM.ViewModels"
    xmlns:models="using:AIM.Models"
    xmlns:converters="using:AIM.Converters"
    d:DataContext="{d:DesignInstance Type=viewmodels:BrowseViewModel}"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </Page.Resources>

        <Grid Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side -->
            <Grid Grid.Column="0" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Left Header -->
                <TextBlock Grid.Row="0" Text="Source" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" HorizontalTextAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                <!-- Left Breadcrumbs -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ItemsRepeater Grid.Column="0" ItemsSource="{Binding LeftBreadcrumbs}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:BreadcrumbItem">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button DataContext="{x:Bind}" Click="LeftBreadcrumbButton_Click" Style="{ThemeResource TextBlockButtonStyle}" Visibility="{x:Bind (x:Boolean)IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                    </Button>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Visibility="{x:Bind IsLast, Mode=OneWay}" VerticalAlignment="Center" Padding="8,4"/>
                                    <TextBlock Text="/" VerticalAlignment="Center" FontWeight="SemiBold" Visibility="{x:Bind (x:Boolean)IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button Grid.Column="1" Command="{Binding GoUpLeftCommand}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74A;" FontSize="16"/>
                            <TextBlock Text="Up"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Left DataGrid -->
                <controls:DataGrid
                x:Name="LeftDataGrid"
                Grid.Row="2"
                ItemsSource="{Binding LeftFilteredContents}"
                SelectionMode="Extended"
                AutoGenerateColumns="False"
                CanUserSortColumns="True"
                Sorting="LeftDataGrid_Sorting"
                SelectionChanged="LeftDataGrid_SelectionChanged"
                DoubleTapped="LeftDataGrid_DoubleTapped"
                PointerPressed="LeftDataGrid_PointerPressed"
                CanDrag="True"
                DragStarting="LeftDataGrid_DragStarting"
                BorderBrush="Gray"
                BorderThickness="1"
                IsReadOnly="True">

                    <controls:DataGrid.Columns>
                        <controls:DataGridTemplateColumn Header="Name" Tag="Name" Width="*">
                            <controls:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="models:ContentItem">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Padding="4,0,0,0">
                                        <SymbolIcon Symbol="{Binding SymbolIcon}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </controls:DataGridTemplateColumn.CellTemplate>
                        </controls:DataGridTemplateColumn>
                        <controls:DataGridTextColumn Header="Date Modified" Binding="{Binding ModifiedDateString}" Tag="Date" Width="120"/>
                        <controls:DataGridTextColumn Header="Size" Binding="{Binding SizeString}" Tag="Size" Width="100"/>
                        </controls:DataGrid.Columns>
                </controls:DataGrid>
            </Grid>

        <!-- Middle Column -->
        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Spacing="8" Margin="8">
            <Button Command="{Binding RenameFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8AC;" Foreground="#0078D4"/>
                    <TextBlock Text="Rename"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ArchiveFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7B8;" Foreground="#EA6100"/>
                    <TextBlock Text="Archive"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ShipFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E1;" Foreground="#107C10"/>
                    <TextBlock Text="Shipped"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding MoveFileCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8DE;" Foreground="#0078D4"/>
                    <TextBlock Text="Move"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding UndoCommand}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE7A7;" Foreground="#0078D4"/>
                    <TextBlock Text="Undo"/>
                </StackPanel>
            </Button>
            <Rectangle Height="24"/>
            <Button Command="{Binding CopyFromScansCommand}" Style="{StaticResource AccentButtonStyle}" MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8C8;" Foreground="#107C10"/>
                    <TextBlock Text="Copy from Scans"/>
                </StackPanel>
            </Button>
        </StackPanel>

            <!-- Right Side -->
            <Grid Grid.Column="2" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Right Header -->
                <TextBlock Grid.Row="0" Text="Destination" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" HorizontalTextAlignment="Center"  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>

                <!-- Right Breadcrumbs -->
                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ItemsRepeater Grid.Column="0" ItemsSource="{Binding RightBreadcrumbs}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="models:BreadcrumbItem">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button DataContext="{x:Bind}" Click="RightBreadcrumbButton_Click" Style="{ThemeResource TextBlockButtonStyle}" Visibility="{x:Bind (x:Boolean)IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                    </Button>
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" Visibility="{x:Bind IsLast, Mode=OneWay}" VerticalAlignment="Center" Padding="8,4"/>
                                    <TextBlock Text="/" VerticalAlignment="Center" FontWeight="SemiBold" Visibility="{x:Bind (x:Boolean)IsLast, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button Grid.Column="1" Command="{Binding GoUpRightCommand}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74A;" FontSize="16"/>
                            <TextBlock Text="Up"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Right ListView -->
                <ListView Grid.Row="2" ItemsSource="{Binding RightFilteredContents}" SelectedItem="{Binding SelectedRightContent, Mode=TwoWay}" BorderBrush="Gray" BorderThickness="1" AllowDrop="True" DragOver="RightListView_DragOver" Drop="RightListView_Drop">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:ContentItem">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <SymbolIcon Symbol="{Binding SymbolIcon}"/>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
</Page>