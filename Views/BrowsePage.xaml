<Page
    x:Class="AIM.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ListView x:Name="FilesListView" ItemsSource="{x:Bind ViewModel.Files}" SelectionMode="Single" SelectionChanged="FilesListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" Width="200" />
                        <TextBlock Text="{Binding Size}" Width="100" />
                        <TextBlock Text="{Binding LastModified}" Width="150" />
                        <TextBlock Text="{Binding Type}" Width="100" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>